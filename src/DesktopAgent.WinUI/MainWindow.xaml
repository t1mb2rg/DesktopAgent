<Window
    x:Class="DesktopAgent.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DesktopAgent.WinUI">
    <Grid>
        <Grid.Resources>
            <SolidColorBrush x:Key="TesselBrandBrush" Color="#3152E8" />
            <SolidColorBrush x:Key="TesselBrandSoftBrush" Color="#183152E8" />
            <SolidColorBrush x:Key="TesselBrandBorderBrush" Color="#663152E8" />
        </Grid.Resources>

        <NavigationView x:Name="ShellNavigation"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        IsPaneToggleButtonVisible="True"
                        PaneDisplayMode="Left"
                        SelectionChanged="NavigationView_SelectionChanged"
                        Loaded="ShellNavigation_Loaded">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="概览" Tag="home">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Home" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="AI 助手" Tag="ai">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Message" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="待确认" Tag="pending">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Clock" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="布局" Tag="layouts">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="View" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="设置" Tag="settings">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid Padding="32,24,32,32">
                <Grid x:Name="HomeView" Loaded="HomeView_Loaded">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Spacing="5">
                        <TextBlock Text="Tessel" FontSize="30" FontWeight="SemiBold" />
                        <TextBlock Text="看懂当前桌面，需要时再调整。"
                                   Opacity="0.62" />
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,22,0,0" ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="300" />
                        </Grid.ColumnDefinitions>

                        <Border Padding="18"
                                CornerRadius="12"
                                BorderThickness="1"
                                BorderBrush="{StaticResource TesselBrandBorderBrush}"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <Grid RowSpacing="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="当前桌面"
                                                   FontSize="18"
                                                   FontWeight="SemiBold" />
                                        <TextBlock x:Name="HomeRadarFreshnessText"
                                                   Text="等待首次刷新"
                                                   Foreground="{StaticResource TesselBrandBrush}"
                                                   Opacity="0.82" />
                                    </StackPanel>
                                    <Button x:Name="HomeRadarRefreshButton"
                                            Grid.Column="1"
                                            Content="↻ 刷新"
                                            VerticalAlignment="Center"
                                            Click="RefreshRadar_Click" />
                                </Grid>

                                <local:DesktopRadarView x:Name="HomeRadarView"
                                                        Grid.Row="1"
                                                        MinHeight="360" />

                                <Grid Grid.Row="2" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock x:Name="HomeRadarSummaryText"
                                                   Text="等待桌面观察"
                                                   FontWeight="SemiBold" />
                                        <TextBlock x:Name="HomeRadarStatusText"
                                                   Text="Radar 只用于展示，不作为桌面执行依据。"
                                                   Opacity="0.44"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="打开布局"
                                            Foreground="{StaticResource TesselBrandBrush}"
                                            VerticalAlignment="Center"
                                            Click="OpenCurrentLayout_Click" />
                                </Grid>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="10">
                            <Border Padding="15"
                                    CornerRadius="10"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    Tapped="CurrentLayoutCard_Tapped">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="当前布局" FontWeight="SemiBold" Opacity="0.68" />
                                    <TextBlock x:Name="HomeCurrentLayoutText"
                                               Text="正在读取…"
                                               FontSize="20"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="HomeCurrentLayoutDetailText"
                                               Text="正在读取布局摘要。"
                                               TextWrapping="Wrap"
                                               Opacity="0.56" />
                                </StackPanel>
                            </Border>

                            <Border Padding="15"
                                    CornerRadius="10"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    Tapped="AutomationCard_Tapped">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="自动化" FontWeight="SemiBold" Opacity="0.68" />
                                    <TextBlock x:Name="HomeAutomationModeText"
                                               Text="Assisted"
                                               FontSize="20" />
                                    <TextBlock Text="需要你的地方会留给你决定。"
                                               TextWrapping="Wrap"
                                               Opacity="0.56" />
                                </StackPanel>
                            </Border>

                            <Border Padding="15"
                                    CornerRadius="10"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    Tapped="PendingCard_Tapped">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="待确认" FontWeight="SemiBold" Opacity="0.68" />
                                    <TextBlock x:Name="HomePendingCountText"
                                               Text="—"
                                               FontSize="20" />
                                    <TextBlock x:Name="HomePendingDetailText"
                                               Text="正在读取待确认队列。"
                                               TextWrapping="Wrap"
                                               Opacity="0.56" />
                                </StackPanel>
                            </Border>

                            <Border Padding="15"
                                    CornerRadius="10"
                                    BorderThickness="1"
                                    BorderBrush="{StaticResource TesselBrandBorderBrush}"
                                    Background="{StaticResource TesselBrandSoftBrush}">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="桌面概况"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TesselBrandBrush}" />
                                    <TextBlock x:Name="HomeDesktopHealthText"
                                               Text="等待桌面观察"
                                               FontSize="20"
                                               FontWeight="SemiBold" />
                                    <TextBlock x:Name="HomeDesktopHealthDetailText"
                                               Text="刷新后显示项目、屏幕与高密度区域。"
                                               TextWrapping="Wrap"
                                               Opacity="0.58" />
                                </StackPanel>
                            </Border>

                            <Border Padding="15"
                                    CornerRadius="10"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <StackPanel Spacing="9">
                                    <TextBlock Text="快捷入口" FontWeight="SemiBold" Opacity="0.68" />
                                    <Grid RowSpacing="8" ColumnSpacing="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Content="布局"
                                                HorizontalAlignment="Stretch"
                                                Click="QuickOpenLayouts_Click" />
                                        <Button Grid.Column="1"
                                                Content="AI 助手"
                                                HorizontalAlignment="Stretch"
                                                Click="QuickOpenAi_Click" />
                                        <Button Grid.Row="1"
                                                Content="待确认"
                                                HorizontalAlignment="Stretch"
                                                Click="QuickOpenPending_Click" />
                                        <Button Grid.Row="1"
                                                Grid.Column="1"
                                                Content="设置"
                                                Foreground="{StaticResource TesselBrandBrush}"
                                                HorizontalAlignment="Stretch"
                                                Click="QuickOpenSettings_Click" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="2"
                            Margin="0,12,0,0"
                            Padding="14,11"
                            CornerRadius="10"
                            BorderThickness="1"
                            BorderBrush="{StaticResource TesselBrandBorderBrush}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="8"
                                    Height="8"
                                    CornerRadius="4"
                                    Background="{StaticResource TesselBrandBrush}"
                                    VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1"
                                        Margin="0,0,8,0"
                                        Spacing="2"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Tessel 正在常驻" FontWeight="SemiBold" />
                                <TextBlock Text="关闭主窗口后仍留在托盘，需要时再叫它回来。"
                                           Opacity="0.50" />
                            </StackPanel>
                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center">
                                <Button Content="隐藏" Click="Hide_Click" />
                                <Button Content="退出" Click="Exit_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <Grid x:Name="AiView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Spacing="5">
                        <TextBlock Text="AI 助手" FontSize="30" FontWeight="SemiBold" />
                        <TextBlock Text="讨论布局、规则和整理习惯。"
                                   Opacity="0.62" />
                    </StackPanel>

                    <Border Grid.Row="1"
                            Margin="0,24,0,16"
                            CornerRadius="12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="12"
                                    MaxWidth="520"
                                    Padding="40">
                            <TextBlock Text="✦"
                                       FontSize="44"
                                       HorizontalAlignment="Center"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="从一句话开始"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="以后你可以直接说“帮我做一个学习用布局”。AI 生成的方案会成为 LayoutDraft，继续在布局工作台里可视化调整。"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Opacity="0.58" />
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Spacing="8">
                                <Border Padding="10,6"
                                        CornerRadius="10"
                                        Background="{ThemeResource LayerFillColorDefaultBrush}">
                                    <TextBlock Text="学习布局" FontSize="12" />
                                </Border>
                                <Border Padding="10,6"
                                        CornerRadius="10"
                                        Background="{ThemeResource LayerFillColorDefaultBrush}">
                                    <TextBlock Text="调整分区" FontSize="12" />
                                </Border>
                                <Border Padding="10,6"
                                        CornerRadius="10"
                                        Background="{ThemeResource LayerFillColorDefaultBrush}">
                                    <TextBlock Text="整理规则" FontSize="12" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="2" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox PlaceholderText="例如：帮我做一个学习用布局"
                                 IsEnabled="False" />
                        <Button Grid.Column="1" Content="发送" IsEnabled="False" />
                    </Grid>
                </Grid>

                <Grid x:Name="PendingView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="5">
                            <TextBlock Text="待确认" FontSize="30" FontWeight="SemiBold" />
                            <TextBlock x:Name="PendingSummaryText"
                                       Text="正在读取…"
                                       Opacity="0.62" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="↻"
                                Width="40"
                                ToolTipService.ToolTip="刷新待确认队列"
                                VerticalAlignment="Center"
                                Click="RefreshPending_Click" />
                    </Grid>

                    <InfoBar x:Name="PendingStatusBar"
                             Grid.Row="1"
                             Margin="0,16,0,0"
                             IsOpen="False"
                             IsClosable="False" />

                    <Grid Grid.Row="2" Margin="0,16,0,0">
                        <ListView x:Name="PendingList"
                                  Visibility="Collapsed"
                                  SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8"
                                            Padding="16"
                                            CornerRadius="10"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                        <Grid RowSpacing="7" ColumnSpacing="16">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontSize="17"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding CreatedAtText}"
                                                       Opacity="0.52" />

                                            <TextBlock Grid.Row="1"
                                                       Text="{Binding DecisionText}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Grid.Row="1"
                                                       Grid.Column="1"
                                                       Text="{Binding QueueReasonText}"
                                                       Opacity="0.62" />

                                            <TextBlock Grid.Row="2"
                                                       Grid.ColumnSpan="2"
                                                       Text="{Binding ExplanationText}"
                                                       TextWrapping="Wrap"
                                                       Opacity="0.55" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <StackPanel x:Name="PendingEmptyState"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="8">
                            <SymbolIcon Symbol="Accept" />
                            <TextBlock Text="现在没有待确认项目" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="需要你决定的东西会留在这里。"
                                       Opacity="0.55"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <Grid x:Name="LayoutsView" Visibility="Collapsed" />

                <Grid x:Name="SettingsView" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="12" MaxWidth="760" HorizontalAlignment="Left">
                            <TextBlock Text="设置" FontSize="30" FontWeight="SemiBold" />
                            <TextBlock Text="自动化、AI Provider 与产品行为。"
                                       Opacity="0.62" />

                            <InfoBar x:Name="FirstRunInfoBar"
                                     IsOpen="False"
                                     IsClosable="False"
                                     Severity="Informational"
                                     Title="首次运行设置"
                                     Message="先选择自动化模式。AI 可以暂时保持关闭，之后随时回来配置。" />

                            <Border Padding="16"
                                    CornerRadius="10"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Automation Mode" FontSize="18" FontWeight="SemiBold" />
                                    <ComboBox x:Name="AutomationModeCombo" Header="自动化模式" SelectedIndex="1">
                                        <ComboBoxItem Content="Manual · 仅当前明确请求直接执行" />
                                        <ComboBoxItem Content="Assisted · 已确认长期策略可自动通过（默认）" />
                                        <ComboBoxItem Content="Automatic · 本地确定性策略也可自动通过" />
                                    </ComboBox>
                                    <TextBlock Text="Automatic 仍不会让 AI-only 判断直接执行。"
                                               TextWrapping="Wrap"
                                               Opacity="0.58" />
                                </StackPanel>
                            </Border>

                            <Border Padding="16"
                                    CornerRadius="10"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="AI Provider" FontSize="18" FontWeight="SemiBold" />
                                    <ToggleSwitch x:Name="AiEnabledToggle"
                                                  Header="启用 AI"
                                                  OffContent="关闭"
                                                  OnContent="启用" />
                                    <TextBox x:Name="AiEndpointTextBox"
                                             Header="Base URI"
                                             PlaceholderText="https://api.example.com/v1 或 http://127.0.0.1:8000/v1" />
                                    <TextBox x:Name="AiModelTextBox"
                                             Header="Model"
                                             PlaceholderText="例如 Qwen2.5-7B-Instruct" />
                                    <PasswordBox x:Name="AiApiKeyPasswordBox"
                                                 Header="API Key（可选）"
                                                 PlaceholderText="留空保留现有 Key" />
                                    <TextBlock x:Name="AiSecretStatusText"
                                               Text="尚未读取 Secret 状态。"
                                               TextWrapping="Wrap"
                                               Opacity="0.58" />
                                    <Button Content="移除已保存 API Key"
                                            HorizontalAlignment="Left"
                                            Click="RemoveApiKey_Click" />
                                    <TextBlock Text="API Key 只保存在 Windows DPAPI Secret Store。"
                                               Opacity="0.58" />
                                </StackPanel>
                            </Border>

                            <InfoBar x:Name="SettingsStatusBar"
                                     IsOpen="False"
                                     IsClosable="True" />

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="保存" Click="SaveSettings_Click" />
                                <Button x:Name="CompleteFirstRunButton"
                                        Content="完成首次设置"
                                        Visibility="Collapsed"
                                        Click="CompleteFirstRun_Click" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </NavigationView>
    </Grid>
</Window>