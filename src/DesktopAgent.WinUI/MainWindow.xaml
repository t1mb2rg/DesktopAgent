<Window
    x:Class="DesktopAgent.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="32" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="8">
            <TextBlock Text="DesktopAgent" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="M5-00 WinUI 3 feasibility shell" Opacity="0.72" />
        </StackPanel>

        <Border Grid.Row="1" Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <StackPanel Spacing="6">
                <TextBlock Text="● Product shell running" FontWeight="SemiBold" />
                <TextBlock Text="x64 · unpackaged · Windows App SDK 2.3.1" />
                <TextBlock Text="关闭窗口会隐藏到通知区域；再次启动或点击托盘图标会恢复窗口。" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="2"
                   Text="此窗口只用于验证 Product UI 生命周期，不会开启 production unattended automation，也不会调用 Writer。"
                   TextWrapping="Wrap"
                   Opacity="0.72" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="12">
            <Button Content="隐藏到托盘" Click="Hide_Click" />
            <Button Content="显式退出" Click="Exit_Click" />
        </StackPanel>
    </Grid>
</Window>
