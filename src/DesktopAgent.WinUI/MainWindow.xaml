<Window
    x:Class="DesktopAgent.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <NavigationView x:Name="ShellNavigation"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        IsPaneToggleButtonVisible="True"
                        PaneDisplayMode="Left"
                        SelectionChanged="NavigationView_SelectionChanged"
                        Loaded="ShellNavigation_Loaded">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="概览" Tag="home">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Home" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="待确认" Tag="pending">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Clock" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="布局" Tag="layouts">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="View" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="设置" Tag="settings">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid Padding="32,24,32,32">
                <Grid x:Name="HomeView">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Spacing="6">
                        <TextBlock Text="DesktopAgent" FontSize="30" FontWeight="SemiBold" />
                        <TextBlock Text="让桌面保持有序，同时把最终决定留在你手里。"
                                   Opacity="0.72" />
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,24,0,0" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Padding="18"
                                CornerRadius="10"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="7">
                                <TextBlock Text="自动化策略" FontWeight="SemiBold" />
                                <TextBlock x:Name="HomeAutomationModeText" Text="Assisted" FontSize="24" />
                                <TextBlock Text="Mode 只决定允许的后台自动化上限；Automatic 也不会把 AI-only 判断升级成 Writer authority。"
                                           TextWrapping="Wrap"
                                           Opacity="0.72" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1"
                                Padding="18"
                                CornerRadius="10"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="7">
                                <TextBlock Text="安全状态" FontWeight="SemiBold" />
                                <TextBlock Text="Writer 未接入" FontSize="24" />
                                <TextBlock Text="M5-04 只增加设置与 Secret Store，不会触发真实桌面移动。"
                                           TextWrapping="Wrap"
                                           Opacity="0.72" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="2"
                            Margin="0,12,0,0"
                            Padding="18"
                            CornerRadius="10"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="5">
                                <TextBlock Text="产品壳生命周期" FontWeight="SemiBold" />
                                <TextBlock Text="关闭窗口仍会隐藏到托盘；再次启动或点击托盘图标会恢复现有单实例窗口。"
                                           TextWrapping="Wrap"
                                           Opacity="0.72" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Content="隐藏到托盘" Click="Hide_Click" />
                                <Button Content="显式退出" Click="Exit_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <InfoBar Grid.Row="3"
                             Margin="0,12,0,0"
                             IsOpen="True"
                             IsClosable="False"
                             Severity="Informational"
                             Title="M5-04 安全边界"
                             Message="保存设置不会调用 AI，也不会打开 Writer；API Key 只进入 Windows DPAPI Secret Store。" />
                </Grid>

                <Grid x:Name="PendingView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="6">
                            <TextBlock Text="待确认" FontSize="30" FontWeight="SemiBold" />
                            <TextBlock x:Name="PendingSummaryText"
                                       Text="正在读取 Pending Queue…"
                                       Opacity="0.72" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="刷新"
                                VerticalAlignment="Center"
                                Click="RefreshPending_Click" />
                    </Grid>

                    <InfoBar x:Name="PendingStatusBar"
                             Grid.Row="1"
                             Margin="0,16,0,0"
                             IsOpen="False"
                             IsClosable="False" />

                    <Grid Grid.Row="2" Margin="0,16,0,0">
                        <ListView x:Name="PendingList"
                                  Visibility="Collapsed"
                                  SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8"
                                            Padding="16"
                                            CornerRadius="10"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                        <Grid RowSpacing="7" ColumnSpacing="16">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontSize="17"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding CreatedAtText}"
                                                       Opacity="0.62" />

                                            <TextBlock Grid.Row="1"
                                                       Text="{Binding DecisionText}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Grid.Row="1"
                                                       Grid.Column="1"
                                                       Text="{Binding QueueReasonText}"
                                                       Opacity="0.72" />

                                            <TextBlock Grid.Row="2"
                                                       Grid.ColumnSpan="2"
                                                       Text="{Binding ExplanationText}"
                                                       TextWrapping="Wrap"
                                                       Opacity="0.68" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <StackPanel x:Name="PendingEmptyState"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="8">
                            <SymbolIcon Symbol="Accept" />
                            <TextBlock Text="现在没有待确认项目" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="新的 AI-only 判断或可延期冲突会出现在这里。"
                                       Opacity="0.68"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <Grid x:Name="LayoutsView" Visibility="Collapsed">
                    <StackPanel Spacing="10" MaxWidth="760" HorizontalAlignment="Left">
                        <TextBlock Text="布局" FontSize="30" FontWeight="SemiBold" />
                        <TextBlock Text="布局管理入口已经占位。布局预览、编辑与 Atomic Commit 会在 M5-05 接入。"
                                   TextWrapping="Wrap"
                                   Opacity="0.72" />
                        <InfoBar IsOpen="True"
                                 IsClosable="False"
                                 Severity="Informational"
                                 Title="当前仍为安全占位"
                                 Message="进入本页不会调用 Writer，也不会改变桌面位置。" />
                    </StackPanel>
                </Grid>

                <Grid x:Name="SettingsView" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="12" MaxWidth="760" HorizontalAlignment="Left">
                            <TextBlock Text="设置" FontSize="30" FontWeight="SemiBold" />
                            <TextBlock Text="配置自动化上限与 OpenAI-compatible Provider。保存配置本身不会发起 AI 请求。"
                                       TextWrapping="Wrap"
                                       Opacity="0.72" />

                            <InfoBar x:Name="FirstRunInfoBar"
                                     IsOpen="False"
                                     IsClosable="False"
                                     Severity="Informational"
                                     Title="首次运行设置"
                                     Message="先选择自动化模式。AI 可以暂时保持关闭，之后随时回来配置。" />

                            <Border Padding="16"
                                    CornerRadius="10"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Automation Mode" FontSize="18" FontWeight="SemiBold" />
                                    <ComboBox x:Name="AutomationModeCombo" Header="自动化模式" SelectedIndex="1">
                                        <ComboBoxItem Content="Manual · 仅当前明确请求直接执行" />
                                        <ComboBoxItem Content="Assisted · 已确认长期策略可自动通过（默认）" />
                                        <ComboBoxItem Content="Automatic · 本地确定性策略也可自动通过" />
                                    </ComboBox>
                                    <TextBlock Text="Automatic 仍不会让 AI-only 判断直接 AUTO；AI-only 继续进入 Pending Queue。"
                                               TextWrapping="Wrap"
                                               Opacity="0.68" />
                                </StackPanel>
                            </Border>

                            <Border Padding="16"
                                    CornerRadius="10"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="AI Provider" FontSize="18" FontWeight="SemiBold" />
                                    <ToggleSwitch x:Name="AiEnabledToggle"
                                                  Header="启用 AI 辅助理解"
                                                  OffContent="关闭"
                                                  OnContent="启用" />
                                    <TextBox x:Name="AiEndpointTextBox"
                                             Header="Base URI"
                                             PlaceholderText="https://api.example.com/v1 或 http://127.0.0.1:8000/v1" />
                                    <TextBox x:Name="AiModelTextBox"
                                             Header="Model"
                                             PlaceholderText="例如 Qwen2.5-7B-Instruct" />
                                    <PasswordBox x:Name="AiApiKeyPasswordBox"
                                                 Header="API Key（可选）"
                                                 PlaceholderText="留空表示保留现有 Key；本地无认证服务可一直留空" />
                                    <TextBlock x:Name="AiSecretStatusText"
                                               Text="尚未读取 Secret 状态。"
                                               TextWrapping="Wrap"
                                               Opacity="0.68" />
                                    <Button Content="移除已保存 API Key"
                                            HorizontalAlignment="Left"
                                            Click="RemoveApiKey_Click" />
                                    <TextBlock Text="真实 API Key 不写入 settings.json 或 SQLite；Windows 端只落 DPAPI 保护后的 blob。"
                                               TextWrapping="Wrap"
                                               Opacity="0.68" />
                                </StackPanel>
                            </Border>

                            <InfoBar x:Name="SettingsStatusBar"
                                     IsOpen="False"
                                     IsClosable="True" />

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="保存设置" Click="SaveSettings_Click" />
                                <Button x:Name="CompleteFirstRunButton"
                                        Content="完成首次设置"
                                        Visibility="Collapsed"
                                        Click="CompleteFirstRun_Click" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
