<UserControl
    x:Class="DesktopAgent.WinUI.LayoutManagementView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid RowSpacing="14" VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Spacing="4"><TextBlock Text="布局" FontSize="30" FontWeight="SemiBold" /><TextBlock Text="看见空间，再决定怎么摆。" Opacity="0.62" /></StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Button Content="↻" Width="40" ToolTipService.ToolTip="刷新布局列表" Click="RefreshLayouts_Click" /><Button Content="＋ 新建" Click="NewLayoutWithMode_Click" /></StackPanel>
        </Grid>

        <InfoBar x:Name="LayoutStatusBar" Grid.Row="1" IsOpen="False" IsClosable="True" />

        <Border x:Name="WorkspaceLibrarySection" Grid.Row="2" Padding="14" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Loaded="WorkspaceLibrarySection_Loaded">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Text="工作区设计库" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock x:Name="WorkspaceLibraryStatusText" Text="正在读取工作区设计库…" FontSize="12" Opacity="0.58" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button x:Name="WorkspaceLibraryRefreshButton" Grid.Column="1" Content="↻" Width="38" ToolTipService.ToolTip="刷新工作区设计库" Click="RefreshWorkspaceLibrary_Click" />
                </Grid>
                <Grid Grid.Row="1">
                    <TextBlock x:Name="WorkspaceLibraryEmptyText" Text="正在读取…" FontSize="12" Opacity="0.52" VerticalAlignment="Center" />
                    <ListView x:Name="WorkspaceBlueprintList" Visibility="Collapsed" MaxHeight="160" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="6,6" ColumnSpacing="14">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding DesignSummary}" FontSize="11" Opacity="0.58" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{Binding RevisionText}" FontSize="12" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding StructureText}" FontSize="11" Opacity="0.52" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding UpdatedText}" FontSize="11" Opacity="0.48" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>
        </Border>

        <Grid x:Name="LayoutWorkbenchSurface" Grid.Row="3" MinWidth="980" MinHeight="0" VerticalAlignment="Stretch" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" MinWidth="420" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>

            <Border Grid.Column="0" MinHeight="0" VerticalAlignment="Stretch" Padding="12" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid MinHeight="0" RowSpacing="10">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel Spacing="2"><TextBlock Text="我的布局" FontSize="17" FontWeight="SemiBold" /><TextBlock x:Name="LayoutSummaryText" Text="正在读取…" FontSize="12" Opacity="0.58" TextWrapping="Wrap" /></StackPanel>
                    <ListView x:Name="LayoutTemplateList" Grid.Row="1" MinHeight="0" VerticalAlignment="Stretch" SelectionMode="Single" SelectionChanged="LayoutTemplateList_SelectionChanged">
                        <ListView.ItemTemplate><DataTemplate><Grid Padding="6,7" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Spacing="2"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding SecondaryText}" FontSize="11" Opacity="0.56" /></StackPanel><TextBlock Grid.Column="1" Text="{Binding ActiveText}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" /></Grid></DataTemplate></ListView.ItemTemplate>
                    </ListView>
                    <Grid Grid.Row="2" ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Button x:Name="EditLayoutButton" Content="编辑" HorizontalAlignment="Stretch" Click="BeginEditSelectedLayout_Click" /><Button Grid.Column="1" Content="使用" HorizontalAlignment="Stretch" Click="SetActiveLayout_Click" /></Grid>
                </Grid>
            </Border>

            <Border Grid.Column="1" MinHeight="0" VerticalAlignment="Stretch" Padding="14" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid MinHeight="0" RowSpacing="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="2"><TextBlock x:Name="LayoutCanvasDraftNameText" Text="桌面画布" FontSize="17" FontWeight="SemiBold" /><TextBlock x:Name="LayoutCanvasStatusText" Text="选择一个布局查看分区" FontSize="12" Opacity="0.58" /></StackPanel>
                        <ComboBox x:Name="AiWorkspaceDisplayCombo" Grid.Column="1" MinWidth="190" Visibility="Collapsed" VerticalAlignment="Center" SelectionChanged="AiWorkspaceDisplayCombo_SelectionChanged" ToolTipService.ToolTip="切换 AI 多显示器工作区中的单屏草稿" />
                        <Border Grid.Column="2" x:Name="EditingBadge" Visibility="Collapsed" Padding="9,4" CornerRadius="10" Background="{ThemeResource AccentFillColorSecondaryBrush}" VerticalAlignment="Center"><TextBlock Text="编辑中 · 自动化暂停" FontSize="11" /></Border>
                    </Grid>
                    <Border Grid.Row="1" MinHeight="180" CornerRadius="10" Background="{ThemeResource LayerFillColorDefaultBrush}"><Grid><Canvas x:Name="LayoutCanvas" SizeChanged="LayoutCanvas_SizeChanged" /><StackPanel x:Name="LayoutCanvasEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="7"><TextBlock Text="▦" FontSize="42" HorizontalAlignment="Center" Opacity="0.35" /><TextBlock Text="选择一个布局看看" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" /><TextBlock Text="分区和预览位置会直接画在这里" FontSize="12" Opacity="0.52" HorizontalAlignment="Center" /></StackPanel></Grid></Border>
                    <Grid Grid.Row="2" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Padding="10,8" CornerRadius="8" Background="{ThemeResource LayerFillColorDefaultBrush}"><StackPanel Spacing="1"><TextBlock Text="移动" FontSize="11" Opacity="0.52" /><TextBlock x:Name="MoveCountText" Text="—" FontSize="18" FontWeight="SemiBold" /></StackPanel></Border><Border Grid.Column="1" Padding="10,8" CornerRadius="8" Background="{ThemeResource LayerFillColorDefaultBrush}"><StackPanel Spacing="1"><TextBlock Text="保持" FontSize="11" Opacity="0.52" /><TextBlock x:Name="StayCountText" Text="—" FontSize="18" FontWeight="SemiBold" /></StackPanel></Border><Border Grid.Column="2" Padding="10,8" CornerRadius="8" Background="{ThemeResource LayerFillColorDefaultBrush}"><StackPanel Spacing="1"><TextBlock Text="目标屏" FontSize="11" Opacity="0.52" /><TextBlock x:Name="TargetDisplayText" Text="—" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /></StackPanel></Border></Grid>
                    <Grid Grid.Row="3" ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Button x:Name="PreviewLayoutButton" Content="↻ 预览" Click="PreviewLayoutWithDirectApplyGate_Click" />
                        <Button Grid.Column="1" x:Name="OverlayToggleButton" Content="▣ 桌面线框" Click="ToggleOverlay_Click" />
                        <TextBlock Grid.Column="2" x:Name="OverlayStateText" Text="线框关闭" FontSize="12" Opacity="0.55" VerticalAlignment="Center" />
                        <Button Grid.Column="3" x:Name="ApplyToDesktopButton" Content="应用到桌面" IsEnabled="False" Click="ApplyToDesktop_Click" />
                        <Button Grid.Column="4" x:Name="ReconcileRecoveryButton" Content="处理恢复状态" ToolTipService.ToolTip="读取并安全协调未完成的桌面执行会话" Click="ReconcileRecovery_Click" />
                        <Button Grid.Column="5" x:Name="SaveLayoutButton" Content="保存" Click="SaveLayout_Click" />
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" MinHeight="0" VerticalAlignment="Stretch" Padding="14" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <ScrollViewer VerticalAlignment="Stretch" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
                    <Grid>
                        <StackPanel x:Name="LayoutEmptyEditorState" VerticalAlignment="Center" Spacing="8" Margin="0,120,0,0"><TextBlock Text="布局属性" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="选择布局后，这里会显示它的主要属性。" TextWrapping="Wrap" FontSize="12" Opacity="0.58" /></StackPanel>
                        <StackPanel x:Name="LayoutEditorPanel" Visibility="Collapsed" Spacing="10">
                            <TextBlock Text="布局属性" FontSize="17" FontWeight="SemiBold" />
                            <TextBox x:Name="LayoutNameTextBox" Header="名称" PlaceholderText="工作 / 游戏 / 课程" />
                            <ComboBox x:Name="LayoutTargetBindingCombo" Header="目标显示器" SelectedIndex="0"><ComboBoxItem Content="主显示器" /><ComboBoxItem Content="当前选择" /><ComboBoxItem Content="固定设备" /></ComboBox>
                            <TextBox x:Name="LayoutDeviceNameTextBox" Header="设备名" PlaceholderText="\\.\DISPLAY1" />
                            <Grid ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><ComboBox x:Name="LayoutPresetCombo" Header="分区" SelectedIndex="1"><ComboBoxItem Content="单区" /><ComboBoxItem Content="左右两栏" /><ComboBoxItem Content="三栏" /><ComboBoxItem Content="2 × 2" /></ComboBox><Button Grid.Column="1" x:Name="ApplyPresetButton" Content="应用" VerticalAlignment="Bottom" Click="ApplyPreset_Click" /></Grid>
                            <TextBlock x:Name="LayoutRuleSummaryText" Text="0 条规则" FontSize="12" Opacity="0.58" />
                            <TextBlock Text="🎨 点击分区可设置独立颜色" FontSize="10" Opacity="0.52" />
                            <ListView x:Name="LayoutZoneList" Height="145" SelectionMode="Single" SelectionChanged="LayoutZoneList_SelectionChanged"><ListView.ItemTemplate><DataTemplate><Grid Padding="4,5" ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Spacing="1"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding BoundsText}" FontSize="10" Opacity="0.45" /></StackPanel><TextBlock Grid.Column="1" Text="{Binding FlowText}" FontSize="11" Opacity="0.55" VerticalAlignment="Center" /></Grid></DataTemplate></ListView.ItemTemplate></ListView>
                            <Border x:Name="ZoneColorEditorPanel" Visibility="Collapsed" Padding="10" CornerRadius="9" Background="{ThemeResource LayerFillColorDefaultBrush}"><StackPanel Spacing="8"><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Spacing="1"><TextBlock x:Name="SelectedZoneColorNameText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock x:Name="ZoneColorInheritanceText" FontSize="10" Opacity="0.52" /></StackPanel><Border x:Name="SelectedZoneColorSwatch" Grid.Column="1" Width="22" Height="22" CornerRadius="11" BorderBrush="#40FFFFFF" BorderThickness="1" VerticalAlignment="Center" /></Grid><ToggleSwitch x:Name="ZoneColorOverrideToggle" Header="单独颜色" Toggled="ZoneColorOverrideToggle_Toggled" /><Button x:Name="ZoneColorPickerButton" HorizontalAlignment="Stretch"><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="选择颜色" /><TextBlock x:Name="SelectedZoneColorHexText" Grid.Column="1" Opacity="0.58" /></Grid><Button.Flyout><Flyout><ColorPicker x:Name="ZoneColorPicker" ColorSpectrumShape="Ring" IsAlphaEnabled="False" ColorChanged="ZoneColorPicker_ColorChanged" /></Flyout></Button.Flyout></Button><TextBlock x:Name="ZoneColorHintText" FontSize="10" TextWrapping="Wrap" Opacity="0.52" /><StackPanel Orientation="Horizontal" Spacing="6"><Button x:Name="ApplyZoneColorsButton" Content="应用颜色" IsEnabled="False" Click="ApplyZoneColorsButton_Click" /><Button x:Name="RevertZoneColorsButton" Content="还原" IsEnabled="False" Click="RevertZoneColorsButton_Click" /></StackPanel></StackPanel></Border>
                            <Expander x:Name="LayoutPreviewDetails" Header="详细影响" Visibility="Collapsed"><StackPanel Spacing="7" Padding="0,8,0,0"><TextBlock x:Name="LayoutPreviewSummaryText" TextWrapping="Wrap" FontSize="12" /><TextBlock x:Name="LayoutPreviewObservationText" TextWrapping="Wrap" FontSize="10" Opacity="0.48" /><ListView x:Name="LayoutPreviewList" Height="210" SelectionMode="None"><ListView.ItemTemplate><DataTemplate><StackPanel Padding="3,4" Spacing="1"><TextBlock Text="{Binding DisplayName}" FontSize="12" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding CompactText}" FontSize="10" Opacity="0.48" TextTrimming="CharacterEllipsis" /></StackPanel></DataTemplate></ListView.ItemTemplate></ListView></StackPanel></Expander>
                            <Button x:Name="CancelLayoutEditButton" Content="取消编辑" HorizontalAlignment="Left" Click="CancelLayoutEditWithMode_Click" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border x:Name="WorkspaceDetailSurface" Grid.Row="3" Visibility="Collapsed" MinWidth="980" MinHeight="0" Padding="16" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid RowSpacing="14">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Button Content="← 返回工作区设计库" Click="WorkspaceDetailBack_Click" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock x:Name="WorkspaceDetailTitleText" Text="工作区" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="WorkspaceDetailMetaText" Text="只读设计资产" FontSize="12" Opacity="0.56" />
                    </StackPanel>
                    <Border Grid.Column="2" Padding="10,5" CornerRadius="10" Background="{ThemeResource LayerFillColorDefaultBrush}" VerticalAlignment="Center">
                        <TextBlock Text="只读 · 无执行权限" FontSize="11" Opacity="0.68" />
                    </Border>
                </Grid>

                <Grid Grid.Row="1" MinHeight="0" ColumnSpacing="14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="520" /><ColumnDefinition Width="320" /></Grid.ColumnDefinitions>

                    <Border Padding="14" CornerRadius="10" Background="{ThemeResource LayerFillColorDefaultBrush}" MinHeight="0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
                            <StackPanel Spacing="16">
                                <StackPanel Spacing="4">
                                    <TextBlock x:Name="WorkspaceDetailRevisionText" Text="设计版本" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock x:Name="WorkspaceDetailSummaryText" Text="设计摘要" FontSize="13" Opacity="0.72" TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock Text="显示器策略" FontSize="14" FontWeight="SemiBold" />
                                    <StackPanel x:Name="WorkspaceDetailDisplayPoliciesPanel" Spacing="5" />
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock Text="分区" FontSize="14" FontWeight="SemiBold" />
                                    <StackPanel x:Name="WorkspaceDetailZonesPanel" Spacing="5" />
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock Text="保留区域" FontSize="14" FontWeight="SemiBold" />
                                    <StackPanel x:Name="WorkspaceDetailReservedPanel" Spacing="5" />
                                </StackPanel>

                                <Expander Header="分类 → 分区" IsExpanded="False">
                                    <StackPanel x:Name="WorkspaceDetailCategoryRulesPanel" Padding="0,8,0,0" Spacing="5" />
                                </Expander>

                                <StackPanel Spacing="6">
                                    <TextBlock Text="空间关系" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock x:Name="WorkspaceDetailRelationsText" Text="无显式硬关系" FontSize="12" Opacity="0.68" TextWrapping="Wrap" />
                                </StackPanel>

                                <Expander Header="项目例外" IsExpanded="False">
                                    <StackPanel Padding="0,8,0,0" Spacing="6">
                                        <TextBlock x:Name="WorkspaceDetailOverridesSummaryText" FontSize="12" Opacity="0.68" TextWrapping="Wrap" />
                                        <StackPanel x:Name="WorkspaceDetailOverridesPanel" Spacing="5" />
                                    </StackPanel>
                                </Expander>

                                <StackPanel Spacing="6">
                                    <TextBlock Text="来源用户要求" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock x:Name="WorkspaceDetailSourceIntentText" FontSize="12" Opacity="0.68" TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <Border Grid.Column="1" Padding="12" CornerRadius="10" Background="{ThemeResource LayerFillColorDefaultBrush}" MinHeight="0">
                        <Grid RowSpacing="10">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="版本历史" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="选择一个设计版本查看当时的方案。历史版本只读。" FontSize="11" Opacity="0.55" TextWrapping="Wrap" />
                            </StackPanel>
                            <ListView x:Name="WorkspaceRevisionList" Grid.Row="1" MinHeight="0" SelectionMode="Single" SelectionChanged="WorkspaceRevisionList_SelectionChanged">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Padding="6,7" Spacing="2">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding RevisionText}" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="1" Text="{Binding StateText}" FontSize="11" Opacity="0.6" />
                                            </Grid>
                                            <TextBlock Text="{Binding CreatedText}" FontSize="10" Opacity="0.45" />
                                            <TextBlock Text="{Binding Summary}" FontSize="11" Opacity="0.6" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
