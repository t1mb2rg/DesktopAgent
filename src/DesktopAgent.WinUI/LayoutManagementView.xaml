<UserControl
    x:Class="DesktopAgent.WinUI.LayoutManagementView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="12" MaxWidth="980" HorizontalAlignment="Left">
            <TextBlock Text="布局" FontSize="30" FontWeight="SemiBold" />
            <TextBlock Text="创建、预览并保存桌面布局。预览只读取当前桌面事实，保存只修改布局元数据。"
                       TextWrapping="Wrap"
                       Opacity="0.72" />

            <InfoBar IsOpen="True"
                     IsClosable="False"
                     Severity="Informational"
                     Title="M5-05 安全边界"
                     Message="这里没有“应用到桌面”按钮。任何未来真实执行都必须重新观察并 Fresh Replan，当前产品壳不持有 Writer。" />

            <Border Padding="16"
                    CornerRadius="10"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Text="我的布局" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock x:Name="LayoutSummaryText"
                                       Text="正在读取布局…"
                                       Opacity="0.68" />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                            <Button Content="刷新" Click="RefreshLayouts_Click" />
                            <Button Content="新建布局" Click="NewLayout_Click" />
                            <Button Content="加载编辑" Click="LoadLayout_Click" />
                            <Button Content="设为当前" Click="SetActiveLayout_Click" />
                        </StackPanel>
                    </Grid>

                    <ListView x:Name="LayoutTemplateList"
                              Height="190"
                              SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="8,4" ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding VersionText}" Opacity="0.66" />
                                    <TextBlock Grid.Column="2" Text="{Binding ZoneText}" Opacity="0.66" />
                                    <TextBlock Grid.Column="3" Text="{Binding ActiveText}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <InfoBar x:Name="LayoutStatusBar"
                     IsOpen="False"
                     IsClosable="True" />

            <Border x:Name="LayoutEditorCard"
                    Visibility="Collapsed"
                    Padding="16"
                    CornerRadius="10"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="10">
                    <TextBlock Text="布局草稿" FontSize="18" FontWeight="SemiBold" />
                    <InfoBar x:Name="LayoutEditingBlockInfoBar"
                             IsOpen="True"
                             IsClosable="False"
                             Severity="Warning"
                             Title="Automation Policy：BLOCK"
                             Message="正在编辑布局。草稿、预览和保存都不会触发自动桌面移动。" />

                    <TextBox x:Name="LayoutNameTextBox"
                             Header="布局名称"
                             PlaceholderText="例如：工作 / 游戏 / 课程" />

                    <ComboBox x:Name="LayoutTargetBindingCombo"
                              Header="目标显示器绑定"
                              SelectedIndex="0">
                        <ComboBoxItem Content="主显示器" />
                        <ComboBoxItem Content="当前选择的显示器" />
                        <ComboBoxItem Content="固定设备名" />
                    </ComboBox>

                    <TextBox x:Name="LayoutDeviceNameTextBox"
                             Header="设备名（当前选择 / 固定设备名时使用）"
                             PlaceholderText="例如 \\.\DISPLAY1；主显示器模式可留空" />

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="LayoutPresetCombo"
                                  Header="常用分区预设"
                                  SelectedIndex="1">
                            <ComboBoxItem Content="单区全屏" />
                            <ComboBoxItem Content="左右两栏" />
                            <ComboBoxItem Content="三栏" />
                            <ComboBoxItem Content="2 × 2 四宫格" />
                        </ComboBox>
                        <Button Grid.Column="1"
                                Content="套用到草稿"
                                VerticalAlignment="Bottom"
                                Click="ApplyPreset_Click" />
                    </Grid>

                    <StackPanel Spacing="4">
                        <TextBlock x:Name="LayoutRuleSummaryText"
                                   Text="规则：0"
                                   Opacity="0.68" />
                        <ListView x:Name="LayoutZoneList"
                                  Height="150"
                                  SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="6,3" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="{Binding BoundsText}" Opacity="0.68" />
                                        <TextBlock Grid.Column="2" Text="{Binding FlowText}" Opacity="0.68" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="重新观察并预览影响" Click="PreviewLayout_Click" />
                        <Button Content="原子保存草稿" Click="SaveLayout_Click" />
                        <Button Content="取消编辑" Click="CancelLayoutEdit_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border x:Name="LayoutPreviewCard"
                    Visibility="Collapsed"
                    Padding="16"
                    CornerRadius="10"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="8">
                    <TextBlock Text="影响预览" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="LayoutPreviewSummaryText"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="LayoutPreviewObservationText"
                               TextWrapping="Wrap"
                               Opacity="0.62" />
                    <InfoBar IsOpen="True"
                             IsClosable="False"
                             Severity="Informational"
                             Title="Preview ≠ Execute"
                             Message="此预览只说明“按刚刚观察到的桌面会发生什么”。它不会被保存成待重放命令。" />
                    <ListView x:Name="LayoutPreviewList"
                              Height="230"
                              SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="6,3" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="2*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding StateText}" Opacity="0.7" />
                                    <TextBlock Grid.Column="2" Text="{Binding PositionText}" Opacity="0.7" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
