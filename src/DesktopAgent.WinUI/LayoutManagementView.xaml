<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="DesktopAgent.WinUI.LayoutManagementView">
    <Grid RowSpacing="12" VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="设计与布局" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="从设计库选择方案，在桌面画布中预览，再决定应用。" Opacity="0.62" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="↻" Width="40" ToolTipService.ToolTip="刷新布局列表" Click="RefreshLayouts_Click" />
                <Button Content="返回设计库" Click="ReturnToLibrary_Click" />
                <Button Content="校准与恢复" Click="OpenPreparationTools_Click" />
                <Button Content="当前草稿" Click="OpenSharedDesign_Click" />
                <Button Content="新建设计" Click="OpenDesignWorkspace_Click" />
            </StackPanel>
        </Grid>
        <InfoBar x:Name="LayoutStatusBar" Grid.Row="1" IsOpen="False" IsClosable="True" />
        <Border x:Name="LayoutStageBar" Visibility="Collapsed" Grid.Row="2" Padding="10,8" CornerRadius="10" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid ColumnSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button x:Name="StagePrepareButton" Content="设备准备" Click="LayoutStageButton_Click" Tag="Prepare" ToolTipService.ToolTip="这台机器能不能被信任：校准目标屏的网格 + 站定授权" />
                    <Button x:Name="StageDesignButton" Content="设计库" Click="LayoutStageButton_Click" Tag="Design" ToolTipService.ToolTip="图标摆成什么样：选布局、改分区与目标屏" />
                    <Button x:Name="StageExecuteButton" Content="预览与应用" Click="LayoutStageButton_Click" Tag="Execute" ToolTipService.ToolTip="落到桌面：先预览，看清要移动什么，再应用" />
                </StackPanel>
                <TextBlock Grid.Column="1" x:Name="StageHintText" Text="先让这台机器可被信任：校准目标屏的图标网格，并确认它的站定授权。" FontSize="12" Opacity="0.62" VerticalAlignment="Center" TextWrapping="Wrap" />

            </Grid>
        </Border>
        <Border x:Name="DesktopOverlayToolbar" Grid.Row="2" Padding="10,8" CornerRadius="8" Background="{ThemeResource LayerFillColorDefaultBrush}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="OverlayToggleButton" Content="▣ 桌面线框" Click="ToggleOverlay_Click" />
                    <TextBlock x:Name="OverlayStateText" Text="线框关闭 · 只读核对，不移动图标" FontSize="12" Opacity="0.65" VerticalAlignment="Center" />
                </StackPanel>
        </Border>
        <Grid Grid.Row="3" ColumnSpacing="16" MinHeight="0" x:Name="LayoutWorkspaceSurface" SizeChanged="LayoutWorkspaceSurface_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="268" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
                <Border x:Name="WorkspaceLibrarySection" Grid.Row="0" Padding="12" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Loaded="WorkspaceLibrarySection_Loaded" MinHeight="0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="设计库" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock x:Name="WorkspaceLibraryStatusText" Text="正在读取工作区设计库…" FontSize="12" Opacity="0.58" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
                                <Button x:Name="WorkspaceLibraryRefreshButton" Content="↻" Width="38" ToolTipService.ToolTip="刷新工作区设计库" Click="RefreshWorkspaceLibrary_Click" />
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="1">
                            <TextBlock x:Name="WorkspaceLibraryEmptyText" Text="到 AI 助手生成第一个工作区设计" FontSize="12" Opacity="0.52" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <ListView x:Name="WorkspaceBlueprintList" Visibility="Collapsed" SelectionMode="None" VerticalAlignment="Stretch">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Padding="4,8" Spacing="4">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" />
                                            <TextBlock Text="{Binding StructureText}" FontSize="11" Opacity="0.65" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding RevisionText}" FontSize="11" Opacity="0.5" />
                                            <TextBlock Text="{Binding UpdatedText}" FontSize="10" Opacity="0.45" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                        <Expander x:Name="LegacyLayoutsExpander" Grid.Row="2" Header="历史布局" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <Grid MinHeight="0" MaxHeight="360" RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="以前保存的布局" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="LayoutSummaryText" Text="正在读取…" FontSize="12" Opacity="0.58" TextWrapping="Wrap" />
                            <TextBlock x:Name="LayoutSelectionHintText" Visibility="Collapsed" Text="正在编辑：先保存或取消编辑；点选其他模板可确认放弃修改并切换。新设计统一保存在设计库。" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                        <ListView x:Name="LayoutTemplateList" Grid.Row="1" MinHeight="0" VerticalAlignment="Stretch" SelectionMode="Single" SelectionChanged="LayoutTemplateList_SelectionChanged">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="6,7" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding SecondaryText}" FontSize="11" Opacity="0.56" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding ActiveText}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <Grid Grid.Row="2" ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="EditLayoutButton" Content="编辑" HorizontalAlignment="Stretch" Click="BeginEditSelectedLayout_Click" />
                            <Button x:Name="SetActiveLayoutButton" Grid.Column="1" Content="设为当前" HorizontalAlignment="Stretch" Click="SetActiveLayout_Click" ToolTipService.ToolTip="只设置当前模板，不会移动桌面图标" />
                        </Grid>
                    </Grid>
                </Expander>
                    </Grid>
                </Border>
            <Grid Grid.Column="1" MinHeight="0">
                <Border x:Name="PrepareStagePanel" Grid.Row="0" Padding="14" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" MinWidth="0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" VerticalAlignment="Top">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="第一步：校准桌面网格" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="首次使用建议先校准一次。校准会临时创建并移动测试图标，结束后恢复和清理；请先保存桌面工作，过程中不要调整图标或显示设置。也可以先到「设计」查看布局，稍后再校准。" FontSize="13" TextWrapping="Wrap" />
                            <TextBlock Text="无人值守执行的前提只有两件：目标屏的图标网格被实测过，并且你为它站定授权过。" FontSize="12" Opacity="0.58" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                            <Button x:Name="GridProbeButton" Content="校准桌面网格…" ToolTipService.ToolTip="跑一次真机探测，测出这台机器上每块显示器的图标网格（会临时移动测试图标，结束后放回）" Click="RunGridProbe_Click" />
                            <Button x:Name="GridDisplayAuthorizationsButton" Content="已记住的显示器…" ToolTipService.ToolTip="查看并收回「允许无人值守执行」的站定授权" Click="GridDisplayAuthorizations_Click" />
                            <Button x:Name="ReconcileRecoveryButton" Content="处理恢复状态" ToolTipService.ToolTip="读取并安全协调未完成的桌面执行会话" Click="ReconcileRecovery_Click" />
                            <Button x:Name="RollbackLastApplyButton" Content="撤销上次整理…" ToolTipService.ToolTip="把桌面放回最近一次成功整理之前的安全检查点位置：只按检查点还原，绝不凭推断摆回去" Click="RollbackLastApply_Click" />
                        </StackPanel>
                        <TextBlock Grid.Row="2" x:Name="GridPreparationStatusText" Text="先点「校准桌面网格…」查看说明；确认开始后才会运行实测。" FontSize="12" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="3" Text="换屏、改缩放比例或关掉自动排列之后，事实会失效：需要重新校准。" FontSize="11" Opacity="0.52" TextWrapping="Wrap" />
                    </Grid>
                </Border>
                <Grid x:Name="LayoutWorkbenchSurface" Grid.Row="0" MinWidth="0" MinHeight="0" VerticalAlignment="Stretch" ColumnSpacing="12" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="320" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="LayoutCanvasCard" Grid.Column="0" MinHeight="0" VerticalAlignment="Stretch" Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid MinHeight="0" RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock x:Name="LayoutCanvasDraftNameText" Text="桌面画布" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock x:Name="LayoutCanvasStatusText" Text="选择一个布局查看分区" FontSize="12" Opacity="0.58" />
                                </StackPanel>
                                <ComboBox x:Name="AiWorkspaceDisplayCombo" Grid.Column="1" MinWidth="190" Visibility="Collapsed" VerticalAlignment="Center" SelectionChanged="AiWorkspaceDisplayCombo_SelectionChanged" ToolTipService.ToolTip="切换 AI 多显示器工作区中的单屏草稿" />
                                <Border Grid.Column="2" x:Name="EditingBadge" Visibility="Collapsed" Padding="9,4" CornerRadius="10" Background="{ThemeResource AccentFillColorSecondaryBrush}" VerticalAlignment="Center">
                                    <TextBlock Text="编辑中 · 自动化暂停" FontSize="11" />
                                </Border>
                            </Grid>
                            <Border Grid.Row="1" MinHeight="180" CornerRadius="10" Background="{ThemeResource LayerFillColorDefaultBrush}">
                                <Grid>
                                    <Canvas x:Name="LayoutCanvas" SizeChanged="LayoutCanvas_SizeChanged" />
                                    <StackPanel x:Name="LayoutCanvasEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="7">
                                        <TextBlock Text="▦" FontSize="42" HorizontalAlignment="Center" Opacity="0.35" />
                                        <TextBlock Text="选择一个布局看看" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                        <TextBlock Text="分区和预览位置会直接画在这里" FontSize="12" Opacity="0.52" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Grid Grid.Row="2" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Padding="10,8" CornerRadius="8" Background="{ThemeResource LayerFillColorDefaultBrush}">
                                    <StackPanel Spacing="1">
                                        <TextBlock Text="移动" FontSize="11" Opacity="0.52" />
                                        <TextBlock x:Name="MoveCountText" Text="—" FontSize="18" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Padding="10,8" CornerRadius="8" Background="{ThemeResource LayerFillColorDefaultBrush}">
                                    <StackPanel Spacing="1">
                                        <TextBlock Text="保持" FontSize="11" Opacity="0.52" />
                                        <TextBlock x:Name="StayCountText" Text="—" FontSize="18" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Padding="10,8" CornerRadius="8" Background="{ThemeResource LayerFillColorDefaultBrush}" ToolTipService.ToolTip="多屏可用：来源可以是任何屏；一次自动执行只落在一块目标屏，其他屏保持现状">
                                    <StackPanel Spacing="1">
                                        <TextBlock Text="目标屏" FontSize="11" Opacity="0.52" />
                                        <TextBlock x:Name="TargetDisplayText" Text="—" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="一次执行只落这一块屏" FontSize="10" Opacity="0.45" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Border Grid.Row="3" x:Name="ApplyReadinessBar" Padding="10,7" CornerRadius="8" Background="{ThemeResource LayerFillColorDefaultBrush}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock x:Name="ApplyReadinessGlyphText" Text="" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Top" Opacity="0.75" />
                                    <StackPanel Spacing="1">
                                        <TextBlock x:Name="ApplyReadinessHeadlineText" Text="还不能应用 · 没有预览" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock x:Name="ApplyReadinessDetailText" Text="先点「↻ 预览」读一次当前桌面。" FontSize="11" Opacity="0.62" TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Grid Grid.Row="4" x:Name="LayoutActionRow" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="PreviewLayoutButton" Content="刷新桌面预览" Click="PreviewLayoutWithDirectApplyGate_Click" />
                                <Button Grid.Column="1" x:Name="ApplyToDesktopButton" Content="应用到桌面" IsEnabled="False" Click="ApplyToDesktop_Click" Style="{StaticResource AccentButtonStyle}" />
                            </Grid>
                            <Expander x:Name="LayoutPreviewDetails" Header="详细影响" Visibility="Collapsed" HorizontalAlignment="Stretch" Grid.Row="5">
                                <StackPanel Spacing="7" Padding="0,8,0,0">
                                    <TextBlock x:Name="LayoutPreviewSummaryText" TextWrapping="Wrap" FontSize="12" />
                                    <TextBlock x:Name="LayoutPreviewObservationText" TextWrapping="Wrap" FontSize="10" Opacity="0.48" />
                                    <ListView x:Name="LayoutPreviewList" Height="130" SelectionMode="None">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Padding="3,4" Spacing="1">
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding CompactText}" FontSize="10" Opacity="0.48" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Expander>
                        </Grid>
                    </Border>
                    <Border x:Name="LayoutEditorSurface" Grid.Column="1" MinHeight="0" VerticalAlignment="Stretch" Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <ScrollViewer VerticalAlignment="Stretch" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
                            <Grid>
                                <StackPanel x:Name="LayoutEmptyEditorState" VerticalAlignment="Center" Spacing="8" Margin="0,120,0,0">
                                    <TextBlock Text="布局属性" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="选择布局后，这里会显示它的主要属性。" TextWrapping="Wrap" FontSize="12" Opacity="0.58" />
                                </StackPanel>
                                <StackPanel x:Name="LayoutEditorPanel" Visibility="Collapsed" Spacing="10">
                                    <TextBlock Text="布局属性" FontSize="17" FontWeight="SemiBold" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="SaveLayoutButton" Content="保存模板" Click="SaveLayout_Click" />
                                        <Button x:Name="CancelLayoutEditButton" Content="取消编辑" HorizontalAlignment="Left" Click="CancelLayoutEditWithMode_Click" />
                                    </StackPanel>
                                    <TextBox x:Name="LayoutNameTextBox" Header="名称" PlaceholderText="工作 / 游戏 / 课程" />
                                    <ComboBox x:Name="LayoutTargetBindingCombo" Header="目标显示器" SelectedIndex="0">
                                        <ComboBoxItem Content="主显示器" />
                                        <ComboBoxItem Content="当前选择" />
                                        <ComboBoxItem Content="固定设备" />
                                    </ComboBox>
                                    <TextBox x:Name="LayoutDeviceNameTextBox" Header="设备名" PlaceholderText="\\.\DISPLAY1" />
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="LayoutPresetCombo" Header="分区" SelectedIndex="1">
                                            <ComboBoxItem Content="单区" />
                                            <ComboBoxItem Content="左右两栏" />
                                            <ComboBoxItem Content="三栏" />
                                            <ComboBoxItem Content="2 × 2" />
                                        </ComboBox>
                                        <Button Grid.Column="1" x:Name="ApplyPresetButton" Content="应用" VerticalAlignment="Bottom" Click="ApplyPreset_Click" />
                                    </Grid>
                                    <TextBlock x:Name="LayoutRuleSummaryText" Text="0 条规则" FontSize="12" Opacity="0.58" />
                                    <TextBlock Text="🎨 点击分区可设置独立颜色" FontSize="10" Opacity="0.52" />
                                    <ListView x:Name="LayoutZoneList" Height="145" SelectionMode="Single" SelectionChanged="LayoutZoneList_SelectionChanged">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Padding="4,5" ColumnSpacing="6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Spacing="1">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding BoundsText}" FontSize="10" Opacity="0.45" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding FlowText}" FontSize="11" Opacity="0.55" VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                    <Border x:Name="ZoneColorEditorPanel" Visibility="Collapsed" Padding="10" CornerRadius="9" Background="{ThemeResource LayerFillColorDefaultBrush}">
                                        <StackPanel Spacing="8">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="1">
                                                    <TextBlock x:Name="SelectedZoneColorNameText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock x:Name="ZoneColorInheritanceText" FontSize="10" Opacity="0.52" />
                                                </StackPanel>
                                                <Border x:Name="SelectedZoneColorSwatch" Grid.Column="1" Width="22" Height="22" CornerRadius="11" BorderBrush="#40FFFFFF" BorderThickness="1" VerticalAlignment="Center" />
                                            </Grid>
                                            <ToggleSwitch x:Name="ZoneColorOverrideToggle" Header="单独颜色" Toggled="ZoneColorOverrideToggle_Toggled" />
                                            <Button x:Name="ZoneColorPickerButton" HorizontalAlignment="Stretch">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="选择颜色" />
                                                    <TextBlock x:Name="SelectedZoneColorHexText" Grid.Column="1" Opacity="0.58" />
                                                </Grid>
                                                <Button.Flyout>
                                                    <Flyout>
                                                        <ColorPicker x:Name="ZoneColorPicker" ColorSpectrumShape="Ring" IsAlphaEnabled="False" ColorChanged="ZoneColorPicker_ColorChanged" />
                                                    </Flyout>
                                                </Button.Flyout>
                                            </Button>
                                            <TextBlock x:Name="ZoneColorHintText" FontSize="10" TextWrapping="Wrap" Opacity="0.52" />
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Button x:Name="ApplyZoneColorsButton" Content="应用颜色" IsEnabled="False" Click="ApplyZoneColorsButton_Click" />
                                                <Button x:Name="RevertZoneColorsButton" Content="还原" IsEnabled="False" Click="RevertZoneColorsButton_Click" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </Border>
                </Grid>
                <Border x:Name="LibraryOverviewSurface" Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="LibraryDesignTitleText" Text="选择一个设计看看" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock x:Name="LibraryDesignSummaryText" Text="从左侧选择设计，查看分区与显示器安排。" TextWrapping="Wrap" Opacity="0.65"/>
                        </StackPanel>
                        <Canvas x:Name="LibraryDesignCanvas" Grid.Row="1"/>
                        <Grid Grid.Row="2">
                            <TextBlock Text="设计浏览 · 生成精确预览后可确认应用" Opacity="0.6" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                <Button Content="版本与详情" Click="ShowLibraryDetails_Click"/>
                                <Button Content="检查精确预览" Click="WorkspaceRebuildPreview_Click"/>
                                <Button Content="编辑" Click="EditWorkspaceDesign_Click"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
                <Border x:Name="SharedDesignSurface" Visibility="Collapsed" Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="返回设计库" Click="CloseSharedDesign_Click"/>
                            <Button Content="撤销" Click="UndoSharedDesign_Click"/>
                            <Button Content="重做" Click="RedoSharedDesign_Click"/>
                            <Button x:Name="SaveSharedDesignButton" Content="保存为新版本" Click="SaveSharedDesign_Click"/>
                            <Button Content="桌面编辑" Click="OpenWorkspaceDesktopEditor_Click"/>
                            <Button x:Name="PreviewSharedDesignButton" Content="检查精确预览" Click="PreviewSharedDesign_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="SharedDesignSummaryText" Grid.Row="1" TextWrapping="Wrap"/>
                        <Canvas x:Name="SharedDesignCanvas" Grid.Row="2"/>
                        <TextBlock Grid.Row="3" Text="与 AI 助手共享草稿 · 拖动后自动保存草稿 · 拖右下角调整大小 · 保存新版本后写入设计库 · 尚未移动图标" TextWrapping="Wrap" Opacity="0.6"/>
                    </Grid>
                </Border>
                <Border x:Name="WorkspaceDetailSurface" Grid.Row="0" Visibility="Collapsed" MinWidth="0" MinHeight="0" Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid RowSpacing="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Content="← 返回工作区设计库" Click="WorkspaceDetailBack_Click" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock x:Name="WorkspaceDetailTitleText" Text="工作区" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="WorkspaceDetailMetaText" Text="只读设计资产" FontSize="12" Opacity="0.56" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                            <Button Content="编辑此设计" Click="EditWorkspaceDesign_Click" VerticalAlignment="Center" />
                            <Button x:Name="WorkspaceRebuildPreviewButton" Content="生成当前桌面预览" Click="WorkspaceRebuildPreview_Click" VerticalAlignment="Center" ToolTipService.ToolTip="按当前桌面重新编译这个设计版本；先审阅和确认，再应用，不会直接移动图标" />
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="1" MinHeight="0" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="240" />
                            </Grid.ColumnDefinitions>
                            <Border Padding="14" CornerRadius="10" Background="{ThemeResource LayerFillColorDefaultBrush}" MinHeight="0">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
                                    <StackPanel Spacing="16">
                                        <StackPanel Spacing="4">
                                            <TextBlock x:Name="WorkspaceDetailRevisionText" Text="设计版本" FontSize="17" FontWeight="SemiBold" />
                                            <TextBlock x:Name="WorkspaceDetailSummaryText" Text="设计摘要" FontSize="13" Opacity="0.72" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="显示器策略" FontSize="14" FontWeight="SemiBold" />
                                            <StackPanel x:Name="WorkspaceDetailDisplayPoliciesPanel" Spacing="5" />
                                        </StackPanel>
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="分区" FontSize="14" FontWeight="SemiBold" />
                                            <StackPanel x:Name="WorkspaceDetailZonesPanel" Spacing="5" />
                                        </StackPanel>
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="保留区域" FontSize="14" FontWeight="SemiBold" />
                                            <StackPanel x:Name="WorkspaceDetailReservedPanel" Spacing="5" />
                                        </StackPanel>
                                        <Expander Header="分类 → 分区" IsExpanded="False">
                                            <StackPanel x:Name="WorkspaceDetailCategoryRulesPanel" Padding="0,8,0,0" Spacing="5" />
                                        </Expander>
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="空间关系" FontSize="14" FontWeight="SemiBold" />
                                            <TextBlock x:Name="WorkspaceDetailRelationsText" Text="无显式硬关系" FontSize="12" Opacity="0.68" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Expander Header="项目例外" IsExpanded="False">
                                            <StackPanel Padding="0,8,0,0" Spacing="6">
                                                <TextBlock x:Name="WorkspaceDetailOverridesSummaryText" FontSize="12" Opacity="0.68" TextWrapping="Wrap" />
                                                <StackPanel x:Name="WorkspaceDetailOverridesPanel" Spacing="5" />
                                            </StackPanel>
                                        </Expander>
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="来源用户要求" FontSize="14" FontWeight="SemiBold" />
                                            <TextBlock x:Name="WorkspaceDetailSourceIntentText" FontSize="12" Opacity="0.68" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                            <Border Grid.Column="1" Padding="12" CornerRadius="10" Background="{ThemeResource LayerFillColorDefaultBrush}" MinHeight="0">
                                <Grid RowSpacing="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="版本历史" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="选择一个设计版本查看当时的方案。历史版本只读。" FontSize="11" Opacity="0.55" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ListView x:Name="WorkspaceRevisionList" Grid.Row="1" MinHeight="0" SelectionMode="Single" SelectionChanged="WorkspaceRevisionList_SelectionChanged">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Padding="6,7" Spacing="2">
                                                    <Grid ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding RevisionText}" FontWeight="SemiBold" />
                                                        <TextBlock Grid.Column="1" Text="{Binding StateText}" FontSize="11" Opacity="0.6" />
                                                    </Grid>
                                                    <TextBlock Text="{Binding CreatedText}" FontSize="10" Opacity="0.45" />
                                                    <TextBlock Text="{Binding Summary}" FontSize="11" Opacity="0.6" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>