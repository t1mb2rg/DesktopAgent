<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="DesktopAgent.WinUI.AiAssistantView" Loaded="AiAssistantView_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="5">
                <TextBlock Text="AI 助手" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="完整理解一次，之后用轻量对话逐步调整布局。" Opacity="0.62" />
            </StackPanel>
            <ProgressRing x:Name="AiProgressRing" Grid.Column="1" Width="24" Height="24" IsActive="False" Visibility="Collapsed" VerticalAlignment="Center" />
        </Grid>
        <ScrollViewer Grid.Row="1" Margin="0,20,0,16" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="12" MaxWidth="900" HorizontalAlignment="Stretch">
                <Border Padding="18" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="✦" FontSize="34" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1" Spacing="5">
                            <TextBlock Text="先了解桌面，再安排空间" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Text="先让 AI 了解桌面上的全部项目，再描述你希望怎样安排空间。首次分析可能需要几分钟，已有分类可以在后续对话中逐步调整。" TextWrapping="Wrap" Opacity="0.62" />
                            <TextBlock Text="分析和设计不会移动图标。生成预览后，你可以在设计库中检查每块屏幕的布局，再确认是否应用。" TextWrapping="Wrap" Opacity="0.48" />
                        </StackPanel>
                    </Grid>
                </Border>
                <InfoBar x:Name="AiStatusBar" IsOpen="False" IsClosable="False" />
                <Border x:Name="AiResultCard" Visibility="Collapsed" Padding="18" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="5">
                            <TextBlock Text="Tessel 对当前桌面的理解" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock x:Name="AiResultMetaText" Opacity="0.48" TextWrapping="Wrap" />
                            <TextBlock x:Name="AiDesktopSummaryText" FontSize="16" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Spacing="5">
                            <TextBlock Text="当前布局意图" FontWeight="SemiBold" />
                            <TextBlock x:Name="AiIntentSummaryText" TextWrapping="Wrap" Opacity="0.68" />
                        </StackPanel>
                        <StackPanel Spacing="7">
                            <TextBlock Text="语义分类与目标屏" FontWeight="SemiBold" />
                            <StackPanel x:Name="AiCategoriesPanel" Spacing="7" />
                        </StackPanel>
                        <StackPanel Spacing="7">
                            <TextBlock Text="建议区域与保留空间" FontWeight="SemiBold" />
                            <StackPanel x:Name="AiZonesPanel" Spacing="7" />
                        </StackPanel>
                        <StackPanel Spacing="7">
                            <TextBlock Text="需要你确认" FontWeight="SemiBold" />
                            <StackPanel x:Name="AiQuestionsPanel" Spacing="7" />
                        </StackPanel>
                        <Grid Margin="0,4,0,0" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="生成一份基于当前桌面的布局预览。你仍可以返回修改；确认应用前，桌面不会改变。" VerticalAlignment="Center" TextWrapping="Wrap" Opacity="0.52" />
                            <Button x:Name="AiImportLayoutButton" Grid.Column="1" Content="生成精确布局预览" IsEnabled="False" Click="ImportMultiDisplayLayoutDraft_Click" Style="{StaticResource AccentButtonStyle}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="AiGuidanceTextBox" MaxLength="4096" PlaceholderText="例如：大多数图标放副屏，主屏中间留空看壁纸" VerticalAlignment="Center" AcceptsReturn="True" MinHeight="76" TextWrapping="Wrap" Grid.Row="0" Grid.ColumnSpan="5" Margin="0,0,0,10" />
            <Button x:Name="AiProbeButton" Grid.Column="1" Content="测试 AI 连接" Click="TestAiConnection_Click" Grid.Row="1" />
            <Button x:Name="AiRefreshUnderstandingButton" Grid.Column="2" Content="重新理解桌面" Visibility="Collapsed" Click="RefreshUnderstanding_Click" Grid.Row="1" />
            <Button x:Name="AiAnalyzeButton" Grid.Column="3" Content="分析当前桌面" Click="AnalyzeDesktop_Click" Grid.Row="1" Style="{StaticResource AccentButtonStyle}" />
            <Button x:Name="AiCancelButton" Grid.Column="4" Content="取消" Visibility="Collapsed" Click="CancelAnalysis_Click" Grid.Row="1" />
        </Grid>
    </Grid>
</UserControl>
