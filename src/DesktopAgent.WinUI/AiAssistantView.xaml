<UserControl
    x:Class="DesktopAgent.WinUI.AiAssistantView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="5">
                <TextBlock Text="AI 助手" FontSize="30" FontWeight="SemiBold" />
                <TextBlock Text="完整理解一次，之后用轻量对话逐步调整布局。" Opacity="0.62" />
            </StackPanel>
            <ProgressRing x:Name="AiProgressRing" Grid.Column="1" Width="24" Height="24" IsActive="False" Visibility="Collapsed" VerticalAlignment="Center" />
        </Grid>

        <ScrollViewer Grid.Row="1" Margin="0,20,0,16" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="12" MaxWidth="900" HorizontalAlignment="Stretch">
                <Border Padding="18" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="✦" FontSize="34" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1" Spacing="5">
                            <TextBlock Text="桌面语义模型" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Text="第一次“分析当前桌面”会 fresh 读取全部项目并完整理解当前桌面，这一步项目较多时可能需要几分钟。建立模型后，下面的每条修正只发送已有分类、语义屏幕和当前布局状态，不再重新分析所有项目。" TextWrapping="Wrap" Opacity="0.62" />
                            <TextBlock Text="完整理解只生成语义草案，不调用 Writer，也不会移动任何桌面图标。AI 仍然看不到 Windows DeviceName 或物理坐标；它只读取请求内逻辑显示器、网格和项目引用，并规划精确逻辑终点。物理映射和执行仍由本地安全链处理。" TextWrapping="Wrap" Opacity="0.48" />
                        </StackPanel>
                    </Grid>
                </Border>

                <InfoBar x:Name="AiStatusBar" IsOpen="False" IsClosable="False" />

                <Border x:Name="AiResultCard" Visibility="Collapsed" Padding="18" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="5">
                            <TextBlock Text="Tessel 对当前桌面的理解" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock x:Name="AiResultMetaText" Opacity="0.48" TextWrapping="Wrap" />
                            <TextBlock x:Name="AiDesktopSummaryText" FontSize="16" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Spacing="5">
                            <TextBlock Text="当前布局意图" FontWeight="SemiBold" />
                            <TextBlock x:Name="AiIntentSummaryText" TextWrapping="Wrap" Opacity="0.68" />
                        </StackPanel>

                        <StackPanel Spacing="7">
                            <TextBlock Text="语义分类与目标屏" FontWeight="SemiBold" />
                            <StackPanel x:Name="AiCategoriesPanel" Spacing="7" />
                        </StackPanel>

                        <StackPanel Spacing="7">
                            <TextBlock Text="建议区域与保留空间" FontWeight="SemiBold" />
                            <StackPanel x:Name="AiZonesPanel" Spacing="7" />
                        </StackPanel>

                        <StackPanel Spacing="7">
                            <TextBlock Text="需要你确认" FontWeight="SemiBold" />
                            <StackPanel x:Name="AiQuestionsPanel" Spacing="7" />
                        </StackPanel>

                        <Grid Margin="0,4,0,0" ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="生成预览时会 fresh 重读桌面，再由 AI 为每个项目规划请求内逻辑终点和分区边界。本地必须完整校验全部项目、碰撞、保留空间和显示器身份；通过后只生成冻结预览，Writer 仍未获得权限。" VerticalAlignment="Center" TextWrapping="Wrap" Opacity="0.52" />
                            <Button x:Name="AiImportLayoutButton" Grid.Column="1" Content="生成精确布局预览" IsEnabled="False" Click="ImportMultiDisplayLayoutDraft_Click" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="AiGuidanceTextBox" MaxLength="4096" PlaceholderText="例如：大多数图标放副屏，主屏中间留空看壁纸" VerticalAlignment="Center" />
            <Button x:Name="AiProbeButton" Grid.Column="1" Content="测试 AI 连接" Click="TestAiConnection_Click" />
            <Button x:Name="AiRefreshUnderstandingButton" Grid.Column="2" Content="重新理解桌面" Visibility="Collapsed" Click="RefreshUnderstanding_Click" />
            <Button x:Name="AiAnalyzeButton" Grid.Column="3" Content="分析当前桌面" Click="AnalyzeDesktop_Click" />
            <Button x:Name="AiCancelButton" Grid.Column="4" Content="取消" Visibility="Collapsed" Click="CancelAnalysis_Click" />
        </Grid>
    </Grid>
</UserControl>
