<Window x:Class="DesktopAgent.Poc.LayoutTemplates.Preview.LayoutPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="布局预览 — M2-03C-C-B"
        Width="1280" Height="850" MinWidth="1000" MinHeight="700"
        WindowStartupLocation="CenterOwner"
        Closing="OnClosing">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══ 工具栏 ═══ -->
        <Grid Grid.Row="0" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="模板:" FontWeight="SemiBold" />
            <ComboBox x:Name="TemplateCombo" Grid.Column="2"
                      DisplayMemberPath="DisplayText"
                      SelectionChanged="TemplateCombo_SelectionChanged" />

            <TextBlock Grid.Column="4" VerticalAlignment="Center" Text="目标显示器:" FontWeight="SemiBold" />
            <ComboBox x:Name="DisplayCombo" Grid.Column="6"
                      DisplayMemberPath="DisplayText"
                      SelectionChanged="DisplayCombo_SelectionChanged" />

            <StackPanel Grid.Column="8" Orientation="Horizontal">
                <Button x:Name="RefreshButton" Content="刷新数据" Width="80" Click="Refresh_Click" Margin="0,0,6,0" />
                <Button x:Name="GenerateButton" Content="生成预览" Width="80" Click="Generate_Click" />
            </StackPanel>

            <Button x:Name="CloseButton" Grid.Column="10" Content="关闭" Width="60" Click="Close_Click" />
        </Grid>

        <!-- ═══ 主区域 ═══ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="400" />
            </Grid.ColumnDefinitions>

            <!-- ── 左: Canvas ── -->
            <Border Grid.Column="0" BorderBrush="#CCC" BorderThickness="1" Background="#FAFAFA">
                <Canvas x:Name="PreviewCanvas" Background="Transparent"
                        SizeChanged="Canvas_SizeChanged" />
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" />

            <!-- ── 右: 信息面板 ── -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <GroupBox Header="汇总" Padding="4" Margin="0,0,0,6">
                        <TextBlock x:Name="SummaryText" FontSize="12" FontFamily="Consolas"
                                   TextWrapping="Wrap" Text="无有效预览。" />
                    </GroupBox>

                    <GroupBox Header="读取诊断" Padding="4" Margin="0,0,0,6">
                        <TextBlock x:Name="DiagnosticsText" FontSize="11" FontFamily="Consolas"
                                   TextWrapping="Wrap" Text="—" />
                    </GroupBox>

                    <GroupBox Header="目标显示器图标" Padding="4" Margin="0,0,0,6">
                        <DataGrid x:Name="ItemsGrid" AutoGenerateColumns="False"
                                  CanUserAddRows="False" IsReadOnly="True" RowHeight="22" MaxHeight="220">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Width="30" Binding="{Binding Ordinal}" />
                                <DataGridTextColumn Header="类别" Width="70" Binding="{Binding DispositionText}" />
                                <DataGridTextColumn Header="放置" Width="65" Binding="{Binding PlacementStateText}" />
                                <DataGridTextColumn Header="名称" Width="80" Binding="{Binding DisplayName}" />
                                <DataGridTextColumn Header="StableId" Width="60" Binding="{Binding StableIdTruncated}" />
                                <DataGridTextColumn Header="规则" Width="50" Binding="{Binding RuleKindText}" />
                                <DataGridTextColumn Header="状态" Width="55" Binding="{Binding StateText}" />
                                <DataGridTextColumn Header="CurX" Width="40" Binding="{Binding CurrentX}" />
                                <DataGridTextColumn Header="CurY" Width="40" Binding="{Binding CurrentY}" />
                                <DataGridTextColumn Header="TgtX" Width="40" Binding="{Binding TargetX}" />
                                <DataGridTextColumn Header="TgtY" Width="40" Binding="{Binding TargetY}" />
                                <DataGridTextColumn Header="Zone" Width="60" Binding="{Binding ZoneName}" />
                                <DataGridTextColumn Header="Slot" Width="30" Binding="{Binding SlotIndex}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>

                    <GroupBox Header="非目标显示器图标" Padding="4" Margin="0,0,0,6">
                        <DataGrid x:Name="OutOfScopeGrid" AutoGenerateColumns="False"
                                  CanUserAddRows="False" IsReadOnly="True" RowHeight="22" MaxHeight="140">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Width="30" Binding="{Binding Ordinal}" />
                                <DataGridTextColumn Header="名称" Width="100" Binding="{Binding DisplayName}" />
                                <DataGridTextColumn Header="StableId" Width="70" Binding="{Binding StableIdTruncated}" />
                                <DataGridTextColumn Header="所属显示器" Width="100" Binding="{Binding MonitorDeviceName}" />
                                <DataGridTextColumn Header="X" Width="50" Binding="{Binding CurrentX}" />
                                <DataGridTextColumn Header="Y" Width="50" Binding="{Binding CurrentY}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>

                    <GroupBox Header="图例" Padding="4">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="12" Height="12" Fill="#0078D4" Margin="0,0,4,0" />
                            <TextBlock Text="当前位置" Margin="0,0,12,0" FontSize="11" />
                            <Rectangle Width="12" Height="12" Fill="#E81123" Margin="0,0,4,0" />
                            <TextBlock Text="目标位置" Margin="0,0,12,0" FontSize="11" />
                            <Path Stroke="#107C10" StrokeThickness="2" Data="M0,6 L20,6" Margin="0,0,4,0" />
                            <TextBlock Text="移动" FontSize="11" />
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" Margin="0,6,0,0" Padding="6,4" Background="#F3F3F3" CornerRadius="3">
            <TextBlock x:Name="StatusText" FontSize="12" Foreground="#555" TextWrapping="Wrap" Text="就绪。" />
        </Border>
    </Grid>
</Window>
