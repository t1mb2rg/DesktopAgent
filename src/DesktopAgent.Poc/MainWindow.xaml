<Window x:Class="DesktopAgent.Poc.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DesktopAgent PoC  —  M1-01 显示器拓扑与目标选择"
        Width="960"
        Height="660"
        MinWidth="780"
        MinHeight="480"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  标题栏  -->
        <DockPanel Grid.Row="0">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock FontSize="26"
                           FontWeight="SemiBold"
                           Text="显示器拓扑验证  +  目标显示器选择" />
                <TextBlock Margin="0,6,0,0"
                           Foreground="Gray"
                           TextWrapping="Wrap"
                           Text="枚举任意数量显示器，使用虚拟桌面物理像素坐标。单击行选择目标显示器。M1 后续只修改目标显示器。" />
            </StackPanel>

            <Button DockPanel.Dock="Right"
                    Width="130"
                    Height="36"
                    Margin="16,0,0,0"
                    VerticalAlignment="Center"
                    Click="RefreshDisplays_Click"
                    Content="重新读取" />
        </DockPanel>

        <!--  显示器列表  -->
        <DataGrid x:Name="DisplaysGrid"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  SelectionChanged="DisplaysGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="目标"
                                        Width="56">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="16"
                                       Foreground="#0078D4"
                                       Text="{Binding TargetMarker}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="设备"
                                    Width="150"
                                    Binding="{Binding DeviceName}" />
                <DataGridCheckBoxColumn Header="主屏"
                                        Width="70"
                                        Binding="{Binding IsPrimary}" />
                <DataGridTextColumn Header="坐标范围"
                                    Width="220"
                                    Binding="{Binding BoundsText}" />
                <DataGridTextColumn Header="工作区"
                                    Width="220"
                                    Binding="{Binding WorkAreaText}" />
                <DataGridTextColumn Header="DPI"
                                    Width="100"
                                    Binding="{Binding DpiText}" />
                <DataGridTextColumn Header="缩放"
                                    Width="*"
                                    Binding="{Binding ScaleText}" />
            </DataGrid.Columns>
        </DataGrid>

        <!--  状态栏  -->
        <Border Grid.Row="4"
                Padding="12,10"
                Background="#F3F3F3"
                CornerRadius="4">
            <StackPanel>
                <TextBlock x:Name="StatusText"
                           Foreground="#555"
                           Text="等待读取显示器信息。" />
                <TextBlock x:Name="TargetText"
                           Margin="0,4,0,0"
                           FontWeight="SemiBold"
                           Foreground="#0078D4"
                           Text="" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
