<Window x:Class="DesktopAgent.Poc.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DesktopAgent PoC"
        Width="940"
        Height="620"
        MinWidth="760"
        MinHeight="460"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock FontSize="26"
                           FontWeight="SemiBold"
                           Text="显示器拓扑验证" />
                <TextBlock Margin="0,6,0,0"
                           Foreground="Gray"
                           Text="枚举任意数量显示器，并使用虚拟桌面物理像素坐标。" />
            </StackPanel>

            <Button DockPanel.Dock="Right"
                    Width="130"
                    Height="36"
                    Margin="16,0,0,0"
                    VerticalAlignment="Center"
                    Click="RefreshDisplays_Click"
                    Content="重新读取" />
        </DockPanel>

        <DataGrid x:Name="DisplaysGrid"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="设备"
                                    Width="150"
                                    Binding="{Binding DeviceName}" />
                <DataGridCheckBoxColumn Header="主屏"
                                        Width="70"
                                        Binding="{Binding IsPrimary}" />
                <DataGridTextColumn Header="坐标范围"
                                    Width="220"
                                    Binding="{Binding BoundsText}" />
                <DataGridTextColumn Header="工作区"
                                    Width="220"
                                    Binding="{Binding WorkAreaText}" />
                <DataGridTextColumn Header="DPI"
                                    Width="100"
                                    Binding="{Binding DpiText}" />
                <DataGridTextColumn Header="缩放"
                                    Width="*"
                                    Binding="{Binding ScaleText}" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="StatusText"
                   Grid.Row="4"
                   Foreground="Gray"
                   Text="等待读取显示器信息。" />
    </Grid>
</Window>
