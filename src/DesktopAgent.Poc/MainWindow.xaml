<Window x:Class="DesktopAgent.Poc.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DesktopAgent PoC — M1-05C-B 受控布局恢复"
        Width="1040" Height="1060" MinWidth="860" MinHeight="920"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- 0 标题栏 -->
            <RowDefinition Height="8" />       <!-- 1 间隔 -->
            <RowDefinition Height="160" />     <!-- 2 显示器拓扑 -->
            <RowDefinition Height="12" />      <!-- 3 间隔 -->
            <RowDefinition Height="Auto" />    <!-- 4 图标标题 -->
            <RowDefinition Height="4" />       <!-- 5 间隔 -->
            <RowDefinition Height="*" />       <!-- 6 图标列表 -->
            <RowDefinition Height="12" />      <!-- 7 间隔 -->
            <RowDefinition Height="Auto" />    <!-- 8 单图标验证 -->
            <RowDefinition Height="12" />      <!-- 9 间隔 -->
            <RowDefinition Height="Auto" />    <!-- 10 快照标题 -->
            <RowDefinition Height="4" />       <!-- 11 间隔 -->
            <RowDefinition Height="140" />     <!-- 12 快照列表 -->
            <RowDefinition Height="8" />       <!-- 13 间隔 -->
            <RowDefinition Height="200" />     <!-- 14 状态栏 -->
        </Grid.RowDefinitions>

        <!-- ── 0 标题栏 ── -->
        <DockPanel Grid.Row="0">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock FontSize="22" FontWeight="SemiBold" Text="DesktopAgent PoC — M1-04B" />
                <TextBlock Margin="0,4,0,0" Foreground="Gray" TextWrapping="Wrap"
                           Text="M1-01 显示器拓扑  |  M1-02 只读图标枚举  |  M1-03B SQLite 快照  |  M1-04B 单图标移动与恢复" />
            </StackPanel>
        </DockPanel>

        <!-- ── 2 显示器拓扑 ── -->
        <DockPanel Grid.Row="2">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" FontSize="15" FontWeight="SemiBold"
                               Text="显示器拓扑" VerticalAlignment="Center" />
                    <Button x:Name="RefreshDisplaysButton" DockPanel.Dock="Right"
                            Width="110" Height="32" Click="RefreshDisplays_Click" Content="重新读取" />
                </DockPanel>
            </StackPanel>
            <DataGrid x:Name="DisplaysGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                      IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow"
                      SelectionChanged="DisplaysGrid_SelectionChanged" RowHeight="28">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="目标" Width="50">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontSize="16" Foreground="#0078D4" Text="{Binding TargetMarker}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="设备" Width="140" Binding="{Binding DeviceName}" />
                    <DataGridCheckBoxColumn Header="主屏" Width="55" Binding="{Binding IsPrimary}" />
                    <DataGridTextColumn Header="坐标范围" Width="200" Binding="{Binding BoundsText}" />
                    <DataGridTextColumn Header="工作区" Width="200" Binding="{Binding WorkAreaText}" />
                    <DataGridTextColumn Header="DPI" Width="90" Binding="{Binding DpiText}" />
                    <DataGridTextColumn Header="缩放" Width="*" Binding="{Binding ScaleText}" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <!-- ── 4 图标标题 ── -->
        <DockPanel Grid.Row="4">
            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                <TextBlock FontSize="15" FontWeight="SemiBold" Text="桌面图标" />
                <TextBlock x:Name="IconStatsText" Margin="0,2,0,0" Foreground="Gray" Text="尚未读取。" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="SaveSnapshotButton" Width="135" Height="32" Margin="0,0,8,0"
                        Click="SaveSnapshot_Click" Content="保存当前快照" IsEnabled="False" />
                <Button x:Name="ReadIconsButton" Width="130" Height="32"
                        Click="ReadDesktopIcons_Click" Content="读取桌面图标" IsEnabled="True" />
            </StackPanel>
        </DockPanel>

        <!-- ── 6 图标列表 ── -->
        <DataGrid x:Name="IconsGrid" Grid.Row="6" AutoGenerateColumns="False" CanUserAddRows="False"
                  IsReadOnly="True" SelectionMode="Single" RowHeight="26"
                  SelectionChanged="IconsGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="显示名称" Width="180" Binding="{Binding DisplayName}" />
                <DataGridTextColumn Header="标识" Width="200" Binding="{Binding StableIdTruncated}" />
                <DataGridTextColumn Header="类型" Width="70" Binding="{Binding ItemKind}" />
                <DataGridTextColumn Header="X" Width="70" Binding="{Binding PixelX}" />
                <DataGridTextColumn Header="Y" Width="70" Binding="{Binding PixelY}" />
                <DataGridTextColumn Header="所属显示器" Width="130" Binding="{Binding MonitorDisplay}" />
                <DataGridTemplateColumn Header="目标屏幕" Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontWeight="SemiBold" Foreground="#0078D4"
                                       Text="{Binding TargetScreenMarker}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridCheckBoxColumn Header="文件系统" Width="65" Binding="{Binding IsFileSystemItem}" />
                <DataGridCheckBoxColumn Header="系统项目" Width="65" Binding="{Binding IsSystemItem}" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- ── 8 TabControl ── -->
        <TabControl Grid.Row="8">
            <TabItem Header="M1-04B 单图标移动">
                <DockPanel Margin="4">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="单图标实机验证 — M1-04B" />
                        <TextBlock x:Name="MoveSessionText" Margin="0,2,0,0" Foreground="Gray" TextWrapping="Wrap"
                                   Text="当前没有待恢复的移动会话。只允许移动文件系统、非系统图标；移动前会保存并回读验证完整安全快照；本功能不是整桌面恢复。" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <CheckBox x:Name="MoveConsentCheckBox" VerticalAlignment="Center"
                                  Width="200" Margin="0,0,8,0"
                                  Checked="MoveConsentChanged" Unchecked="MoveConsentChanged">
                            <TextBlock TextWrapping="Wrap"
                                       Text="我确认：该操作会真实移动一个桌面文件系统图标，移动后必须恢复原位置" />
                        </CheckBox>
                        <Button x:Name="MoveSelectedIconButton" Width="135" Height="32" Margin="0,0,8,0"
                                Click="MoveSelectedIcon_Click" Content="移动到相邻空位" IsEnabled="False" />
                        <Button x:Name="RestoreOriginalPositionButton" Width="110" Height="32"
                                Click="RestoreOriginalPosition_Click" Content="恢复原位置" IsEnabled="False" />
                    </StackPanel>
                </DockPanel>
            </TabItem>
            <TabItem Header="M1-05C-B 布局恢复">
                <DockPanel Margin="4">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="布局恢复验证 — M1-05C-B" />
                        <TextBlock x:Name="LayoutRestorePreviewText" Margin="0,2,0,0" Foreground="Gray"
                                   TextWrapping="Wrap" Text="尚未预览。只允许单图标、单步骤、无中转的直接移动。" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <CheckBox x:Name="LayoutRestoreConsentCheckBox" VerticalAlignment="Center"
                                  Width="220" Margin="0,0,8,0"
                                  Checked="LayoutRestoreConsentChanged" Unchecked="LayoutRestoreConsentChanged">
                            <TextBlock TextWrapping="Wrap"
                                       Text="我确认：该操作会真实恢复一个桌面文件系统图标；仅允许单图标、单步骤、无中转计划。" />
                        </CheckBox>
                        <Button x:Name="PreviewLayoutRestoreButton" Width="135" Height="32" Margin="0,0,8,0"
                                Click="PreviewLayoutRestore_Click" Content="预览选中快照恢复" IsEnabled="False" />
                        <Button x:Name="ExecuteLayoutRestoreButton" Width="140" Height="32"
                                Click="ExecuteLayoutRestore_Click" Content="执行一次受控恢复" IsEnabled="False" />
                    </StackPanel>
                </DockPanel>
            </TabItem>
        </TabControl>

        <!-- ── 10 快照标题 ── -->
        <DockPanel Grid.Row="10">
            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                <TextBlock FontSize="15" FontWeight="SemiBold" Text="布局快照" />
                <TextBlock x:Name="SnapshotStatsText" Margin="0,2,0,0" Foreground="Gray"
                           TextWrapping="Wrap" Text="正在初始化…" />
            </StackPanel>
            <Button x:Name="RefreshSnapshotsButton" DockPanel.Dock="Right"
                    Width="90" Height="32" Click="RefreshSnapshots_Click"
                    Content="刷新列表" IsEnabled="False" />
        </DockPanel>

        <!-- ── 12 快照列表 ── -->
        <DataGrid x:Name="SnapshotsGrid" Grid.Row="12" AutoGenerateColumns="False"
                  CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single" RowHeight="26"
                  SelectionChanged="SnapshotsGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="创建时间（本地）" Width="160" Binding="{Binding CreatedAtLocal}" />
                <DataGridTextColumn Header="图标数" Width="65" Binding="{Binding IconCount}" />
                <DataGridTextColumn Header="目标显示器" Width="140" Binding="{Binding TargetMonitorDeviceName}" />
                <DataGridTextColumn Header="连接方式" Width="120" Binding="{Binding ConnectionMethod}" />
                <DataGridTextColumn Header="格式版本" Width="70" Binding="{Binding FormatVersion}" />
                <DataGridTextColumn Header="SnapshotId" Width="*" Binding="{Binding SnapshotId}" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- ── 14 状态栏 ── -->
        <Border Grid.Row="14" Padding="8,6" Background="#F3F3F3" CornerRadius="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,4">
                    <Button x:Name="CopyDiagnosticsButton" DockPanel.Dock="Right"
                            Width="80" Height="26" FontSize="12"
                            Click="CopyDiagnostics_Click" Content="复制诊断" />
                    <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                               FontSize="13" FontWeight="SemiBold" Foreground="#555"
                               Text="运行状态 / 诊断" />
                </DockPanel>
                <TextBox x:Name="StatusText" Grid.Row="1" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                         AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top" FontFamily="Consolas" FontSize="12"
                         Foreground="#333" Background="Transparent"
                         BorderThickness="1" BorderBrush="#DDD" Padding="4"
                         Text="等待读取显示器信息。" />
                <TextBlock x:Name="TargetText" Grid.Row="2" Margin="0,4,0,0"
                           FontWeight="SemiBold" Foreground="#0078D4" Text="" />
            </Grid>
        </Border>
    </Grid>
</Window>
