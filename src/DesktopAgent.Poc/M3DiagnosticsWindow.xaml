<Window x:Class="DesktopAgent.Poc.M3DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DesktopAgent — M3 Read-only Diagnostics / Suggestion / Notification"
        Width="1020" Height="1000" MinWidth="860" MinHeight="760"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock FontSize="20" FontWeight="SemiBold"
                       Text="M3 只读桌面诊断 / Suggestion / Windows Notification" />
            <TextBlock Margin="0,5,0,0" Foreground="#666" TextWrapping="Wrap"
                       Text="Observation / Diff / Suggestion / Notification 全程只读。Suggestion 中的 M2 Candidate 只是当时的计划证据，不是执行授权；本窗口没有 Writer，也没有“执行整理”按钮。" />
        </StackPanel>

        <Border Grid.Row="2" Padding="10" Background="#F5F9FF"
                BorderBrush="#B8D8FF" BorderThickness="1" CornerRadius="4">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="RunOnceButton" Width="110" Height="32" Margin="0,0,8,0"
                            Click="RunOnce_Click" Content="观察一轮" />
                    <Button x:Name="ResetBaselineButton" Width="100" Height="32" Margin="0,0,8,0"
                            Click="ResetBaseline_Click" Content="重置基线" />
                    <Button x:Name="CopyButton" Width="90" Height="32"
                            Click="Copy_Click" Content="复制诊断" />
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="SummaryText" FontWeight="SemiBold" Foreground="#245A92"
                               Text="尚未运行。第一次成功稳定观察只会建立 baseline。" />
                    <TextBlock Margin="0,3,12,0" Foreground="#777" FontSize="12" TextWrapping="Wrap"
                               Text="Unstable / Unavailable 不推进 baseline。后台监听运行时，手动观察和重置基线禁用，避免绕过 single-flight。" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="4" Padding="10" Background="#F7FBF6"
                BorderBrush="#B9DBB5" BorderThickness="1" CornerRadius="4">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="StartMonitoringButton" Width="125" Height="32" Margin="0,0,8,0"
                            Click="StartMonitoring_Click" Content="启动后台监听" />
                    <Button x:Name="StopMonitoringButton" Width="125" Height="32"
                            Click="StopMonitoring_Click" Content="停止后台监听" IsEnabled="False" />
                </StackPanel>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock x:Name="MonitoringStatusText" FontWeight="SemiBold" Foreground="#3A7137"
                               Text="后台监听：未启动（需要手动开启）" />
                    <TextBlock Margin="0,3,0,0" Foreground="#777" FontSize="12" TextWrapping="Wrap"
                               Text="Desktop FileSystemWatcher 负责新增 / 删除 / 重命名的低延迟提示；15 秒 periodic fallback 负责最终重新观察，包括纯图标位置拖动等静默变化。" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="6" Padding="10" Background="#FFF9F0"
                BorderBrush="#E8C98B" BorderThickness="1" CornerRadius="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="210" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"
                               FontWeight="SemiBold" Text="Suggestion 模板" />
                    <ComboBox x:Name="SuggestionTemplateComboBox" Grid.Column="1" Height="30"
                              SelectionChanged="SuggestionTemplate_SelectionChanged" />

                    <TextBlock Grid.Column="3" VerticalAlignment="Center" Margin="0,0,8,0"
                               FontWeight="SemiBold" Text="SelectedTarget" />
                    <ComboBox x:Name="SuggestionTargetComboBox" Grid.Column="4" Height="30" IsEnabled="False" />

                    <StackPanel Grid.Column="6" Orientation="Horizontal">
                        <Button x:Name="RefreshSuggestionOptionsButton" Width="74" Height="30" Margin="0,0,6,0"
                                Click="RefreshSuggestionOptions_Click" Content="刷新" />
                        <Button x:Name="ApplySuggestionBindingButton" Width="82" Height="30" Margin="0,0,6,0"
                                Click="ApplySuggestionBinding_Click" Content="应用绑定" />
                        <Button x:Name="ClearSuggestionBindingButton" Width="82" Height="30"
                                Click="ClearSuggestionBinding_Click" Content="清除绑定" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock x:Name="SuggestionBindingStatusText" FontWeight="SemiBold" Foreground="#8A5A17"
                                   Text="Suggestion Binding：未配置。后台不会猜测模板。" />
                        <TextBlock x:Name="SuggestionStatusText" Margin="0,4,0,0" Foreground="#555" TextWrapping="Wrap"
                                   Text="当前 Suggestion：无。" />
                        <TextBlock Margin="0,3,0,0" Foreground="#777" FontSize="12" TextWrapping="Wrap"
                                   Text="Active 只表示建议可展示；Suspended 表示当前事实暂时不能确认。真正执行以后仍必须 fresh reread + fresh rebuild 回到 M2 安全链。" />
                    </StackPanel>
                    <Button x:Name="DismissSuggestionButton" Grid.Column="1" Width="110" Height="30"
                            VerticalAlignment="Top" Click="DismissSuggestion_Click"
                            Content="忽略当前建议" IsEnabled="False" />
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="8" Padding="10" Background="#F8F5FF"
                BorderBrush="#CBBBF2" BorderThickness="1" CornerRadius="4">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="SimulateNotificationOpenButton" Width="96" Height="30" Margin="0,0,8,0"
                            Click="SimulateNotificationOpen_Click" Content="模拟打开" IsEnabled="False" />
                    <Button x:Name="SimulateNotificationIgnoreButton" Width="96" Height="30"
                            Click="SimulateNotificationIgnore_Click" Content="模拟忽略" IsEnabled="False" />
                </StackPanel>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock x:Name="NotificationStatusText" FontWeight="SemiBold" Foreground="#60449A"
                               Text="Windows App Notification：无当前通知。" TextWrapping="Wrap" />
                    <TextBlock x:Name="NotificationSchedulerStatusText" Margin="0,4,0,0"
                               Foreground="#666" TextWrapping="Wrap"
                               Text="Notification scheduler：等待 Suggestion lifecycle。验收 cooldown = 30s。" />
                    <TextBlock Margin="0,3,0,0" Foreground="#777" FontSize="12" TextWrapping="Wrap"
                               Text="04C 已连接真实 Windows App Notification。这里同时保留 diagnostics mirror 和模拟按钮：模拟 Open 只激活本窗口；模拟 Ignore 使用 SuggestionId 原子校验。没有执行整理动作。" />
                </StackPanel>
            </DockPanel>
        </Border>

        <TextBox x:Name="DiagnosticsText" Grid.Row="10"
                 IsReadOnly="True" IsReadOnlyCaretVisible="True"
                 AcceptsReturn="True" AcceptsTab="True"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas" FontSize="12"
                 Padding="8" BorderBrush="#D6D6D6" BorderThickness="1"
                 Text="M3 diagnostics / suggestion / Windows notification ready.&#x0D;&#x0A;" />
    </Grid>
</Window>
