<Window x:Class="DesktopAgent.Poc.M3DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DesktopAgent — M3 Read-only Monitoring Diagnostics"
        Width="860" Height="720" MinWidth="700" MinHeight="540"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock FontSize="20" FontWeight="SemiBold"
                       Text="M3-02E 只读后台监控诊断" />
            <TextBlock Margin="0,5,0,0" Foreground="#666" TextWrapping="Wrap"
                       Text="真实 Windows hint → bounded debounce → single-flight → 两次 fresh Observation → Stability → 会话内 baseline → State Diff。事件只负责唤醒，当前事实始终来自 fresh observation。" />
        </StackPanel>

        <Border Grid.Row="2" Padding="10" Background="#F5F9FF"
                BorderBrush="#B8D8FF" BorderThickness="1" CornerRadius="4">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="RunOnceButton" Width="110" Height="32" Margin="0,0,8,0"
                            Click="RunOnce_Click" Content="请求观察" />
                    <Button x:Name="ResetBaselineButton" Width="100" Height="32" Margin="0,0,8,0"
                            Click="ResetBaseline_Click" Content="重置基线" />
                    <Button x:Name="CopyButton" Width="90" Height="32"
                            Click="Copy_Click" Content="复制诊断" />
                </StackPanel>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock x:Name="MonitoringText" FontWeight="SemiBold" Foreground="#245A92"
                               Text="后台监控状态：正在初始化…" />
                    <TextBlock x:Name="SummaryText" Margin="0,4,0,0" Foreground="#555" TextWrapping="Wrap"
                               Text="等待 Runtime 建立第一份 fresh stable baseline。" />
                    <TextBlock Margin="0,3,0,0" Foreground="#777" FontSize="12" TextWrapping="Wrap"
                               Text="“请求观察”只发布 Manual hint，不绕过后台队列。Unstable / Unavailable 不推进 baseline。纯图标拖动目前仍可能没有 FileSystem hint，后续 source 会补齐。" />
                </StackPanel>
            </DockPanel>
        </Border>

        <TextBox x:Name="DiagnosticsText" Grid.Row="4"
                 IsReadOnly="True" IsReadOnlyCaretVisible="True"
                 AcceptsReturn="True" AcceptsTab="True"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas" FontSize="12"
                 Padding="8" BorderBrush="#D6D6D6" BorderThickness="1"
                 Text="M3 background diagnostics ready.&#x0D;&#x0A;" />
    </Grid>
</Window>
