<Window x:Class="DesktopAgent.Poc.M3DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DesktopAgent — M3 Read-only Diagnostics"
        Width="820" Height="680" MinWidth="680" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock FontSize="20" FontWeight="SemiBold"
                       Text="M3-01D 只读桌面诊断" />
            <TextBlock Margin="0,5,0,0" Foreground="#666" TextWrapping="Wrap"
                       Text="每次“观察一轮”都会执行两次 fresh Observation → 稳定性判定 → 会话内 baseline → State Diff。该窗口不持有 Writer，不会移动任何桌面图标。" />
        </StackPanel>

        <Border Grid.Row="2" Padding="10" Background="#F5F9FF"
                BorderBrush="#B8D8FF" BorderThickness="1" CornerRadius="4">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="RunOnceButton" Width="110" Height="32" Margin="0,0,8,0"
                            Click="RunOnce_Click" Content="观察一轮" />
                    <Button x:Name="ResetBaselineButton" Width="100" Height="32" Margin="0,0,8,0"
                            Click="ResetBaseline_Click" Content="重置基线" />
                    <Button x:Name="CopyButton" Width="90" Height="32"
                            Click="Copy_Click" Content="复制诊断" />
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="SummaryText" FontWeight="SemiBold" Foreground="#245A92"
                               Text="尚未运行。第一次成功稳定观察只会建立 baseline。" />
                    <TextBlock Margin="0,3,12,0" Foreground="#777" FontSize="12" TextWrapping="Wrap"
                               Text="Unstable / Unavailable 不会推进 baseline。调试采样间隔由 DI 配置，目前仅用于 PoC。" />
                </StackPanel>
            </DockPanel>
        </Border>

        <TextBox x:Name="DiagnosticsText" Grid.Row="4"
                 IsReadOnly="True" IsReadOnlyCaretVisible="True"
                 AcceptsReturn="True" AcceptsTab="True"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas" FontSize="12"
                 Padding="8" BorderBrush="#D6D6D6" BorderThickness="1"
                 Text="M3 diagnostics ready.&#x0D;&#x0A;" />
    </Grid>
</Window>
