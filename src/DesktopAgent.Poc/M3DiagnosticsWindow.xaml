<Window x:Class="DesktopAgent.Poc.M3DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DesktopAgent — M3 Read-only Diagnostics"
        Width="880" Height="760" MinWidth="720" MinHeight="580"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock FontSize="20" FontWeight="SemiBold"
                       Text="M3 只读桌面诊断 / 监控 PoC" />
            <TextBlock Margin="0,5,0,0" Foreground="#666" TextWrapping="Wrap"
                       Text="手动观察和后台监听都只走 fresh Observation → Stability → session baseline → State Diff。该窗口和监控会话都没有 Writer，不会移动任何桌面图标。" />
        </StackPanel>

        <Border Grid.Row="2" Padding="10" Background="#F5F9FF"
                BorderBrush="#B8D8FF" BorderThickness="1" CornerRadius="4">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="RunOnceButton" Width="110" Height="32" Margin="0,0,8,0"
                            Click="RunOnce_Click" Content="观察一轮" />
                    <Button x:Name="ResetBaselineButton" Width="100" Height="32" Margin="0,0,8,0"
                            Click="ResetBaseline_Click" Content="重置基线" />
                    <Button x:Name="CopyButton" Width="90" Height="32"
                            Click="Copy_Click" Content="复制诊断" />
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="SummaryText" FontWeight="SemiBold" Foreground="#245A92"
                               Text="尚未运行。第一次成功稳定观察只会建立 baseline。" />
                    <TextBlock Margin="0,3,12,0" Foreground="#777" FontSize="12" TextWrapping="Wrap"
                               Text="Unstable / Unavailable 不会推进 baseline。后台监听运行时，手动观察和重置基线会被禁用，避免绕过 single-flight。" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="4" Padding="10" Background="#F7FBF6"
                BorderBrush="#B9DBB5" BorderThickness="1" CornerRadius="4">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="StartMonitoringButton" Width="125" Height="32" Margin="0,0,8,0"
                            Click="StartMonitoring_Click" Content="启动后台监听" />
                    <Button x:Name="StopMonitoringButton" Width="125" Height="32"
                            Click="StopMonitoring_Click" Content="停止后台监听" IsEnabled="False" />
                </StackPanel>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock x:Name="MonitoringStatusText" FontWeight="SemiBold" Foreground="#3A7137"
                               Text="后台监听：未启动（需要手动开启）" />
                    <TextBlock Margin="0,3,0,0" Foreground="#777" FontSize="12" TextWrapping="Wrap"
                               Text="Desktop FileSystemWatcher 负责新增 / 删除 / 重命名的低延迟提示；15 秒 periodic fallback 负责最终重新观察，包括纯图标位置拖动等静默变化。" />
                </StackPanel>
            </DockPanel>
        </Border>

        <TextBox x:Name="DiagnosticsText" Grid.Row="6"
                 IsReadOnly="True" IsReadOnlyCaretVisible="True"
                 AcceptsReturn="True" AcceptsTab="True"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas" FontSize="12"
                 Padding="8" BorderBrush="#D6D6D6" BorderThickness="1"
                 Text="M3 diagnostics ready.&#x0D;&#x0A;" />
    </Grid>
</Window>
